---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";

import heroBg from "../assets/images/RECURSOS/equipoInnova.png";
import fotoCol40 from "../assets/images/RECURSOS/col40.png";
import fotoEquipoProg from "../assets/images/RECURSOS/equipo_programando.jpg";
import foto2Fondo from "../assets/images/RECURSOS/foto 2 fondoooo.png";
import fotoJovenesRurales from "../assets/images/RECURSOS/foto jovenes rurales.png";
import imgNuestrosValores from "../assets/images/RECURSOS/nuestros-valores.png";
import imgMision from "../assets/images/RECURSOS/mision amarillo.png";
import imgVision from "../assets/images/RECURSOS/vision amarillo.png";
import imgValores1 from "../assets/images/RECURSOS/marca-de-verificacion amarillo.png";
import imgYimi from "../assets/images/yimi.webp";
import imgBrayan from "../assets/images/brayan.webp";
import imgSara from "../assets/images/sara.webp";
import iconCrece from "../assets/images/RECURSOS/logro amarillo.png";
import iconColabo from "../assets/images/RECURSOS/grupo personas amarillo.png";
import iconInnova from "../assets/images/RECURSOS/3d amarillo.png";

const pageTitle = "Sobre Nosotros | INNOVA SYSTEMS CENTER";
const pageDescription =
  "Conoce el equipo, historia, misión y valores de INNOVA SYSTEMS CENTER.";
const pageKeywords =
  "nosotros, equipo, historia, misión, visión, valores, innova systems center";

const tecnologias = [
  "Python",
  "JavaScript",
  "HTML/CSS",
  "Java",
  "PHP",
  "React / Vue",
  "Django / Spring Boot",
  "Node.js",
  "MySQL / PostgreSQL",
  "ODK / Kobotoolbox",
  "Power BI / Tableau",
  "Adobe Suite / DaVinci",
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main class="min-h-screen bg-[#0a0a0a] text-white">
    <!-- ═══════════ HERO ═══════════ -->
    <section class="ns-hero" style={`background-image:url('${heroBg.src}')`}>
      <div class="ns-hero__overlay"></div>
      <div class="ns-container ns-hero__content">
        <p class="ns-tag">QUIÉNES SOMOS</p>
        <h1 class="ns-hero__title">
          INNOVA SYSTEMS CENTER<br />
          <span class="text-[#F39C12]"
            >Soluciones tecnológicas para<br />empresas modernas</span
          >
        </h1>
        <p class="ns-hero__sub">
          Somos un equipo interdisciplinario con más de <strong
            >10 años de experiencia</strong
          > en desarrollo, automatización, análisis de datos y producción digital.
        </p>
        <div class="ns-hero__btns">
          <a href="/contacto#formulario-contacto" class="ns-btn-primary"
            >Solicita una consultoría</a
          >
          <a href="/#nuestros_servicios" class="ns-btn-outline">Ver servicios</a
          >
        </div>

      </div>
    </section>

    <!-- ═══════════ BARRA STATS ═══════════ -->
    <div class="ns-statsbar">
      <div class="ns-container">
        <div class="ns-statsbar__grid">

          <!-- 10+ -->
          <div class="ns-statsbar__item">
            <span class="ns-statsbar__num">10+</span>
            <span class="ns-statsbar__lbl">Años de<br/>experiencia</span>
          </div>

          <div class="ns-statsbar__sep"></div>

          <!-- 30+ -->
          <div class="ns-statsbar__item">
            <span class="ns-statsbar__num">30+</span>
            <span class="ns-statsbar__lbl">Clientes<br/>satisfechos</span>
          </div>

          <div class="ns-statsbar__sep"></div>

          <!-- Lista servicios -->
          <div class="ns-statsbar__services">
            <ul>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                Desarrollo Web a Medida
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                Bases de Datos &amp; Automatización
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                Análisis y Recolección de Datos
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                Producción de Contenido Digital
              </li>
            </ul>
          </div>

          <div class="ns-statsbar__sep"></div>

          <!-- 100% -->
          <div class="ns-statsbar__item">
            <span class="ns-statsbar__num">100%</span>
            <span class="ns-statsbar__lbl">Compromiso en la Innovación<br/>práctica y resultados medibles</span>
          </div>

        </div>
      </div>
    </div>

    <!-- ═══════════ NUESTRA HISTORIA ═══════════ -->
    <section class="ns-section bg-[#0f0f0f]">
      <div class="ns-container">
        <p class="ns-tag">NUESTRA HISTORIA</p>
        <div class="ns-historia-grid">
          <!-- Texto -->
          <div class="ns-historia-text">
            <h2 class="ns-heading">
              Un camino construido sobre innovación,<br />
              <span class="text-[#F39C12]">experiencia y tecnología</span>
            </h2>
            <p class="ns-body">
              Innova Systems Center nace con una visión clara: convertirnos en
              el
              <strong class="text-white">aliado tecnológico estratégico</strong> para
              empresas que buscan evolucionar, digitalizarse y mejorar la forma en
              que operan.
            </p>
            <p class="ns-body">
              Desde nuestros primeros años, nos especializamos en resolver
              desafíos complejos mediante
              <span class="text-[#F39C12] font-semibold"
                >soluciones diseñadas a medida</span
              >: sistemas de información geográfica, plataformas de software,
              automatización de procesos, almacenamiento en la nube, gestión de
              datos y herramientas digitales personalizadas.
            </p>
            <p class="ns-body">
              Hoy somos más que una empresa de tecnología: somos
              <strong class="text-white">arquitectos digitales</strong>,
              construyendo soluciones que impulsan crecimiento, productividad y
              competitividad.
            </p>
            <div class="ns-divider"></div>
          </div>
          <!-- Fotos -->
          <div class="ns-historia-imgs">
            <img
              src={fotoCol40.src}
              alt="Equipo Innova en campo"
              class="ns-hist-img ns-hist-img--top"
            />
            <img
              src={fotoEquipoProg.src}
              alt="Equipo programando"
              class="ns-hist-img ns-hist-img--bot"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ MISIÓN / VISIÓN / VALORES ═══════════ -->
    <section class="ns-section bg-[#151515]">
      <div class="ns-container">
        <div class="ns-mvv3-grid">

          <!-- ── MISIÓN (izquierda, fondo oscuro) ── -->
          <div class="ns-mvv3-card ns-mvv3-dark">
            <img src={fotoCol40.src} alt="Equipo Innova" class="ns-mvv3-topimg" />
            <div class="ns-mvv3-header">
              <img src={imgMision.src} alt="Misión" class="ns-mvv3-icon" />
              <span class="ns-mvv3-title">NUESTRA MISIÓN</span>
            </div>
            <p class="ns-mvv3-body">
              Brindar <strong class="ns-mvv3-highlight">soluciones informáticas innovadoras</strong>
              que optimicen procesos, aumenten la eficiencia y potencien el crecimiento de las
              empresas mediante tecnología avanzada, enfoque estratégico y acompañamiento continuo.
            </p>
          </div>

          <!-- ── VISIÓN (centro, fondo oscuro) ── -->
          <div class="ns-mvv3-card ns-mvv3-dark">
            <img src={fotoJovenesRurales.src} alt="Jóvenes rurales" class="ns-mvv3-topimg" />
            <div class="ns-mvv3-header">
              <img src={imgVision.src} alt="Visión" class="ns-mvv3-icon" />
              <span class="ns-mvv3-title">NUESTRA VISIÓN (2028)</span>
            </div>
            <p class="ns-mvv3-body">
              Ser <strong class="ns-mvv3-highlight">líderes en innovación tecnológica en Colombia</strong>, desarrollando
              soluciones avanzadas en IA, automatización, plataformas inteligentes y digitalización
              empresarial para impactar sectores clave y transformar su productividad.
            </p>
          </div>

          <!-- ── VALORES (derecha, fondo oscuro) ── -->
          <div class="ns-mvv3-card ns-mvv3-dark">
            <img src={imgNuestrosValores.src} alt="Nuestros valores" class="ns-mvv3-topimg" />
            <span class="ns-mvv3-title ns-mvv3-title--solo">NUESTROS VALORES</span>
            <ul class="ns-mvv3-list">
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span><strong>Innovación:</strong> mejoramos continuamente nuestras soluciones.</span>
              </li>
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span><strong>Compromiso:</strong> resultados reales y medibles para nuestros clientes.</span>
              </li>
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span><strong>Transparencia:</strong> procesos claros, reportes y comunicación constante.</span>
              </li>
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span><strong>Calidad:</strong> soluciones robustas, seguras y diseñadas para escalar.</span>
              </li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════ EQUIPO ═══════════ -->
    <section class="ns-section bg-[#0a0a0a]">
      <div class="ns-container">
        <p class="ns-tag text-center">NUESTRO EQUIPO</p>
        <h2 class="ns-heading text-center mb-14">
          Un equipo experto que impulsa tu<br />
          <span class="text-[#F39C12]">transformación digital</span>
        </h2>

        <div class="ns-team-grid">
          <div class="ns-team-card">
            <div class="ns-team-avatar">
              <img src={imgYimi.src} alt="Yimi Vacca" />
            </div>
            <h3 class="ns-team-name">Yimi Vacca</h3>
            <p class="ns-team-role">CEO &amp; Fundador</p>
            <p class="ns-team-desc">
              Líder estratégico con más de 10 años diseñando soluciones
              tecnológicas enfocadas en crecimiento empresarial.
            </p>
          </div>

          <div class="ns-team-card">
            <div class="ns-team-avatar">
              <img src={imgBrayan.src} alt="Brayan Jamanoy" />
            </div>
            <h3 class="ns-team-name">Brayan Jamanoy</h3>
            <p class="ns-team-role">CTO &amp; Arquitecto de Software</p>
            <p class="ns-team-desc">
              Especialista en arquitectura de software, automatización y
              sistemas escalables para organizaciones modernas.
            </p>
          </div>

          <div class="ns-team-card">
            <div class="ns-team-avatar">
              <img src={imgSara.src} alt="Sara Arboleda" />
            </div>
            <h3 class="ns-team-name">Sara Arboleda</h3>
            <p class="ns-team-role">Coordinadora de Proyectos Digitales</p>
            <p class="ns-team-desc">
              Experta en gestión de proyectos tecnológicos con enfoque en
              producción digital y comunicación estratégica.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ TECNOLOGÍAS ═══════════ -->
    <section class="ns-section bg-[#111]">
      <div class="ns-container">
        <p class="ns-tag">TECNOLOGÍA</p>
        <h2 class="ns-heading mb-10">Tecnologías que usamos</h2>
        <div class="ns-tech-grid">
          {tecnologias.map((t) => <div class="ns-tech-tag">{t}</div>)}
        </div>
      </div>
    </section>

    <!-- ═══════════ NUESTRA CULTURA ═══════════ -->
    <section class="ns-section bg-[#0f0f0f]">
      <div class="ns-container">
        <p class="ns-tag text-center">NUESTRA CULTURA</p>
        <h2 class="ns-heading text-center mb-4">
          Crecemos contigo: cultura enfocada en<br />
          <span class="text-[#F39C12]"
            >innovación, aprendizaje y resultados reales</span
          >
        </h2>
        <p class="text-gray-300 text-center max-w-2xl mx-auto mb-14">
          En INNOVA SYSTEMS CENTER creemos que el talento florece cuando tiene
          los recursos correctos. Cada integrante trabaja en proyectos reales
          que generan impacto directo en organizaciones de Colombia y
          Latinoamérica.
        </p>

        <div class="ns-cultura-grid">
          <div class="ns-cultura-card">
            <img src={iconCrece.src} alt="" class="ns-cultura-icon" />
            <h3 class="ns-cultura-title">Crecimiento profesional</h3>
            <p class="ns-cultura-desc">
              Cada proyecto te reta, te enseña y mejora tu nivel técnico con
              resultados reales.
            </p>
          </div>
          <div class="ns-cultura-card">
            <img src={iconColabo.src} alt="" class="ns-cultura-icon" />
            <h3 class="ns-cultura-title">Trabajo colaborativo</h3>
            <p class="ns-cultura-desc">
              Equipos multidisciplinarios con desarrolladores, creativos y
              analistas de datos.
            </p>
          </div>
          <div class="ns-cultura-card">
            <img src={iconInnova.src} alt="" class="ns-cultura-icon" />
            <h3 class="ns-cultura-title">Ambiente innovador</h3>
            <p class="ns-cultura-desc">
              Apostamos por la experimentación, nuevas ideas y tecnología de
              vanguardia.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA / CONTACTO ═══════════ -->
    <section id="contact-form" class="ns-cta">
      <div class="ns-container text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          ¿Listo para automatizar y optimizar tus datos?
        </h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-10">
          Agenda una sesión gratuita y descubre cómo podemos llevar tu empresa
          al siguiente nivel con tecnología real y resultados medibles.
        </p>
        <a
          href="/contacto#formulario-contacto"
          class="ns-btn-primary text-lg px-12 py-4">Agenda tu sesión</a
        >
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* ─── Variables ─── */
  .ns-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  .ns-section {
    padding: 5rem 1.5rem;
  }
  .ns-tag {
    color: #f39c12;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    display: block;
  }
  .ns-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  .ns-body {
    color: #9ca3af;
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .ns-divider {
    width: 4rem;
    height: 3px;
    background: #f39c12;
    border-radius: 2px;
    margin-top: 1.5rem;
  }

  /* ─── Botones ─── */
  .ns-btn-primary {
    display: inline-block;
    background: #f39c12;
    color: #000;
    font-weight: 700;
    padding: 0.85rem 2rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition:
      background 0.25s,
      transform 0.2s;
  }
  .ns-btn-primary:hover {
    background: #ffc04a;
    transform: scale(1.04);
  }
  .ns-btn-outline {
    display: inline-block;
    border: 2px solid #f39c12;
    color: #f39c12;
    font-weight: 700;
    padding: 0.85rem 2rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.25s;
  }
  .ns-btn-outline:hover {
    background: rgba(243, 156, 18, 0.1);
  }

  /* ─── Hero ─── */
  .ns-hero {
    position: relative;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
  }
  .ns-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1;
  }
  .ns-hero__content {
    position: relative;
    z-index: 2;
    padding: 8rem 1.5rem 4rem;
  }
  .ns-hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .ns-hero__sub {
    color: #ccc;
    font-size: 1.05rem;
    max-width: 560px;
    margin-bottom: 2rem;
  }
  .ns-hero__btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  /* Stats bar */
  .ns-statsbar {
    background: #111;
    border-top: 1px solid rgba(243, 156, 18, 0.2);
    border-bottom: 1px solid rgba(243, 156, 18, 0.2);
    padding: 2rem 1.5rem;
  }
  .ns-statsbar__grid {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .ns-statsbar__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-align: left;
  }
  .ns-statsbar__num {
    font-size: 2.4rem;
    font-weight: 900;
    color: #f39c12;
    line-height: 1;
    white-space: nowrap;
  }
  .ns-statsbar__lbl {
    font-size: 0.82rem;
    color: #aaa;
    line-height: 1.4;
  }
  .ns-statsbar__sep {
    width: 1px;
    height: 3.5rem;
    background: rgba(243, 156, 18, 0.3);
    flex-shrink: 0;
    align-self: center;
  }
  .ns-statsbar__services ul {
    list-style: none;
    padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.35rem;
  }
  .ns-statsbar__services li {
    display: flex; align-items: center; gap: 0.5rem;
    color: #ccc; font-size: 0.82rem;
  }
  .ns-statsbar__services li svg {
    width: 14px; height: 14px;
    color: #F39C12; flex-shrink: 0;
  }
  @media (max-width: 700px) {
    .ns-statsbar__sep { display: none; }
    .ns-statsbar__grid { justify-content: flex-start; gap: 1.25rem; }
  }
  @media (max-width: 600px) {
    .ns-statsbar__sep {
      display: none;
    }
  }

  /* ─── Historia ─── */
  .ns-historia-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    margin-top: 2rem;
  }
  @media (max-width: 860px) {
    .ns-historia-grid {
      grid-template-columns: 1fr;
    }
  }
  .ns-historia-imgs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ns-hist-img {
    width: 100%;
    border-radius: 1rem;
    object-fit: cover;
  }
  .ns-hist-img--top {
    height: 240px;
  }
  .ns-hist-img--bot {
    height: 200px;
  }

  /* ─── Misión/Visión/Valores ─── */
  .ns-mvv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    align-items: start;
    margin-bottom: 2rem;
  }
  @media (max-width: 900px) {
    .ns-mvv-grid {
      grid-template-columns: 1fr;
    }
  }
  .ns-mvv-card {
    background: #1a1a1a;
    border: 1px solid rgba(243, 156, 18, 0.2);
    border-radius: 1rem;
    padding: 1.75rem;
  }
  .ns-mvv-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .ns-mvv-icon {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .ns-mvv-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ns-mvv-big-img {
    width: 100%;
    border-radius: 1rem;
    object-fit: cover;
    max-height: 340px;
  }

  /* Valores lista */
  .ns-valores-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ns-valores-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: #9ca3af;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .ns-val-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .ns-valores-hero-img {
    width: 100%;
    border-radius: 0.75rem;
    object-fit: cover;
    max-height: 150px;
    margin-bottom: 1rem;
