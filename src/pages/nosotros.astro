---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";

import heroBg from "../assets/images/RECURSOS/equipoInnova.png";
import fotoCol40 from "../assets/images/RECURSOS/col40.png";
import fotoEquipoProg from "../assets/images/RECURSOS/equipo_programando.jpg";
import foto2Fondo from "../assets/images/RECURSOS/foto 2 fondoooo.png";
import fotoJovenesRurales from "../assets/images/RECURSOS/foto jovenes rurales.png";
import imgNuestrosValores from "../assets/images/RECURSOS/nuestros-valores.png";
import imgMision from "../assets/images/RECURSOS/mision amarillo.png";
import imgVision from "../assets/images/RECURSOS/vision amarillo.png";
import imgValores1 from "../assets/images/RECURSOS/marca-de-verificacion amarillo.png";
import imgYimi from "../assets/images/yimi.webp";
import imgBrayan from "../assets/images/brayan.webp";
import imgSara from "../assets/images/sara.webp";
import imgDiego from "../assets/images/Diego.png";
import iconCrece from "../assets/images/RECURSOS/logro amarillo.png";
import iconColabo from "../assets/images/RECURSOS/grupo personas amarillo.png";
import iconInnova from "../assets/images/RECURSOS/3d amarillo.png";

// ── Iconos de tecnologías ──
import iconPython from "../assets/images/icons/python.png";
import iconJS from "../assets/images/icons/javascript.png";
import iconHTML from "../assets/images/icons/html.png";
import iconJava from "../assets/images/icons/java.png";
import iconPHP from "../assets/images/icons/php.png";
import iconReact from "../assets/images/icons/react.png";
import iconDjango from "../assets/images/icons/django.png";
import iconNode from "../assets/images/icons/node.png";
import iconVue from "../assets/images/icons/vue.png";
import iconSpringBoot from "../assets/images/icons/springboot.png";
import iconPostgres from "../assets/images/icons/posgressql.png";
import iconODK from "../assets/images/icons/odk.svg";
import iconKobo from "../assets/images/icons/kobo.svg";
import iconEnketo from "../assets/images/icons/enketo.svg";
import iconOna from "../assets/images/icons/ona.svg";
import iconPowerBI from "../assets/images/icons/power_bi.svg";
import iconTableau from "../assets/images/icons/tableau.svg";
import iconLooker from "../assets/images/icons/looker.svg";
import iconGAnalytics from "../assets/images/icons/g_analitics.svg";
import iconAudacity from "../assets/images/icons/audacity.svg";
import iconAudition from "../assets/images/icons/audition.svg";
import iconDJ from "../assets/images/icons/dj.svg";
import iconAdobeSuite from "../assets/images/icons/adobe_suite.png";

const pageTitle = "Sobre Nosotros | INNOVA SYSTEMS CENTER";
const pageDescription =
  "Conoce el equipo, historia, misión and valores de INNOVA SYSTEMS CENTER.";
const pageKeywords =
  "nosotros, equipo, historia, misión, visión, valores, innova systems center";

// ── Tecnologías segmentadas por servicio ──
const techServicios = [
  {
    servicio: "Desarrollo Web a Medida",
    icono: "🌐",
    tecnologias: [
      { nombre: "Python", img: iconPython.src },
      { nombre: "JavaScript", img: iconJS.src },
      { nombre: "HTML / CSS", img: iconHTML.src },
      { nombre: "Java", img: iconJava.src },
      { nombre: "PHP", img: iconPHP.src },
      { nombre: "React", img: iconReact.src },
      { nombre: "Django", img: iconDjango.src },
      { nombre: "Node.js", img: iconNode.src },
      { nombre: "Vue", img: iconVue.src },
      { nombre: "Spring Boot", img: iconSpringBoot.src },
      { nombre: "MySQL / PostgreSQL", img: iconPostgres.src },
    ],
  },
  {
    servicio: "Análisis y Recolección de Datos",
    icono: "📊",
    tecnologias: [
      { nombre: "Python", img: iconPython.src },
      { nombre: "ODK", img: iconODK.src },
      { nombre: "KoBoToolbox", img: iconKobo.src },
      { nombre: "Enketo", img: iconEnketo.src },
      { nombre: "ONA", img: iconOna.src },
      { nombre: "Power BI", img: iconPowerBI.src },
      { nombre: "Tableau", img: iconTableau.src },
      { nombre: "Looker Studio", img: iconLooker.src },
      { nombre: "Google Analytics", img: iconGAnalytics.src },
    ],
  },
  {
    servicio: "Producción de Contenido Digital",
    icono: "🎬",
    tecnologias: [
      { nombre: "Audacity", img: iconAudacity.src },
      { nombre: "Adobe Audition", img: iconAudition.src },
      { nombre: "DaVinci Resolve", img: iconDJ.src },
      { nombre: "Adobe Suite", img: iconAdobeSuite.src },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main class="min-h-screen bg-[#0a0a0a] text-white">
    <!-- ═══════════ HERO ═══════════ -->
    <section class="ns-hero" style={`background-image:url('${heroBg.src}')`}>
      <div class="ns-hero__overlay"></div>
      <div class="ns-container ns-hero__content">
        <p class="ns-tag">QUIÉNES SOMOS</p>
        <h1 class="ns-hero__title">
          INNOVA SYSTEMS CENTER<br />
          <span class="text-[#F39C12]"
            >Soluciones tecnológicas para<br />empresas modernas</span
          >
        </h1>
        <p class="ns-hero__sub">
          Somos un equipo interdisciplinario con más de <strong
            >10 años de experiencia</strong
          > en desarrollo, automatización, análisis de datos y producción digital.
        </p>
        <div class="ns-hero__btns">
          <a href="/contacto#formulario-contacto" class="ns-btn-primary"
            >Solicita una consultoría</a
          >
          <a href="/#nuestros_servicios" class="ns-btn-outline">Ver servicios</a
          >
        </div>
      </div>
    </section>

    <!-- ═══════════ BARRA STATS ═══════════ -->
    <div class="ns-statsbar">
      <div class="ns-container">
        <div class="ns-statsbar__grid">
          <!-- 10+ -->
          <div class="ns-statsbar__item">
            <span class="ns-statsbar__num">10+</span>
            <span class="ns-statsbar__lbl">Años de<br />experiencia</span>
          </div>

          <div class="ns-statsbar__sep"></div>

          <!-- 30+ -->
          <div class="ns-statsbar__item">
            <span class="ns-statsbar__num">30+</span>
            <span class="ns-statsbar__lbl">Clientes<br />satisfechos</span>
          </div>

          <div class="ns-statsbar__sep"></div>

          <!-- Lista servicios -->
          <div class="ns-statsbar__services">
            <ul>
              <li>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  ><path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                    clip-rule="evenodd"></path></svg
                >
                Desarrollo Web a Medida
              </li>
              <li>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  ><path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                    clip-rule="evenodd"></path></svg
                >
                Análisis y Recolección de Datos
              </li>
              <li>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  ><path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                    clip-rule="evenodd"></path></svg
                >
                Producción de Contenido Digital
              </li>
            </ul>
          </div>

          <div class="ns-statsbar__sep"></div>

          <!-- 100% -->
          <div class="ns-statsbar__item">
            <span class="ns-statsbar__num">100%</span>
            <span class="ns-statsbar__lbl"
              >Compromiso en la Innovación<br />práctica y resultados medibles</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════ NUESTRA HISTORIA ═══════════ -->
    <section class="ns-section bg-[#0f0f0f]">
      <div class="ns-container">
        <p class="ns-tag">NUESTRA HISTORIA</p>
        <div class="ns-historia-grid">
          <!-- Texto -->
          <div class="ns-historia-text">
            <h2 class="ns-heading">
              Un camino construido sobre innovación,<br />
              <span class="text-[#F39C12]">experiencia y tecnología</span>
            </h2>
            <p class="ns-body">
              Innova Systems Center nace con una visión clara: convertirnos en
              el
              <strong class="text-white">aliado tecnológico estratégico</strong> para
              empresas que buscan evolucionar, digitalizarse y mejorar la forma en
              que operan.
            </p>
            <p class="ns-body">
              Desde nuestros primeros años, nos especializamos en resolver
              desafíos complejos mediante
              <span class="text-[#F39C12] font-semibold"
                >soluciones diseñadas a medida</span
              >: sistemas de información geográfica, plataformas de software,
              automatización de procesos, almacenamiento en la nube, gestión de
              datos y herramientas digitales personalizadas.
            </p>
            <p class="ns-body">
              Hoy somos más que una empresa de tecnología: somos
              <strong class="text-white">arquitectos digitales</strong>,
              construyendo soluciones que impulsan crecimiento, productividad y
              competitividad.
            </p>
            <div class="ns-divider"></div>
          </div>
          <!-- Fotos -->
          <div class="ns-historia-imgs">
            <img
              src={fotoCol40.src}
              alt="Equipo Innova en campo"
              class="ns-hist-img ns-hist-img--top"
            />
            <img
              src={fotoEquipoProg.src}
              alt="Equipo programando"
              class="ns-hist-img ns-hist-img--bot"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ MISIÓN / VISIÓN / VALORES ═══════════ -->
    <section class="ns-section bg-[#151515]">
      <div class="ns-container">
        <div class="ns-mvv3-grid">
          <!-- ── MISIÓN (izquierda, fondo oscuro) ── -->
          <div class="ns-mvv3-card ns-mvv3-dark">
            <img
              src={fotoCol40.src}
              alt="Equipo Innova"
              class="ns-mvv3-topimg"
            />
            <div class="ns-mvv3-header">
              <img src={imgMision.src} alt="Misión" class="ns-mvv3-icon" />
              <span class="ns-mvv3-title">NUESTRA MISIÓN</span>
            </div>
            <p class="ns-mvv3-body">
              Brindar <strong class="ns-mvv3-highlight"
                >soluciones informáticas innovadoras</strong
              >
              que optimicen procesos, aumenten la eficiencia y potencien el crecimiento
              de las empresas mediante tecnología avanzada, enfoque estratégico y
              acompañamiento continuo.
            </p>
          </div>

          <!-- ── VISIÓN (centro, fondo oscuro) ── -->
          <div class="ns-mvv3-card ns-mvv3-dark">
            <img
              src={fotoJovenesRurales.src}
              alt="Jóvenes rurales"
              class="ns-mvv3-topimg"
            />
            <div class="ns-mvv3-header">
              <img src={imgVision.src} alt="Visión" class="ns-mvv3-icon" />
              <span class="ns-mvv3-title">NUESTRA VISIÓN (2028)</span>
            </div>
            <p class="ns-mvv3-body">
              Ser <strong class="ns-mvv3-highlight"
                >líderes en innovación tecnológica en Colombia</strong
              >, desarrollando soluciones avanzadas en IA, automatización,
              plataformas inteligentes y digitalización empresarial para
              impactar sectores clave y transformar su productividad.
            </p>
          </div>

          <!-- ── VALORES (derecha, fondo oscuro) ── -->
          <div class="ns-mvv3-card ns-mvv3-dark">
            <img
              src={imgNuestrosValores.src}
              alt="Nuestros valores"
              class="ns-mvv3-topimg"
            />
            <span class="ns-mvv3-title ns-mvv3-title--solo"
              >NUESTROS VALORES</span
            >
            <ul class="ns-mvv3-list">
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span
                  ><strong>Innovación:</strong> mejoramos continuamente nuestras soluciones.</span
                >
              </li>
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span
                  ><strong>Compromiso:</strong> resultados reales y medibles para
                  nuestros clientes.</span
                >
              </li>
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span
                  ><strong>Transparencia:</strong> procesos claros, reportes y comunicación
                  constante.</span
                >
              </li>
              <li>
                <img src={imgValores1.src} alt="" class="ns-mvv3-listicon" />
                <span
                  ><strong>Calidad:</strong> soluciones robustas, seguras y diseñadas
                  para escalar.</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ EQUIPO ═══════════ -->
    <section class="ns-section bg-[#0a0a0a]">
      <div class="ns-container">
        <p class="ns-tag text-center">NUESTRO EQUIPO</p>
        <h2 class="ns-heading text-center mb-14">
          Un equipo experto que impulsa tu<br />
          <span class="text-[#F39C12]">transformación digital</span>
        </h2>

        <div class="ns-team-grid">
          <!-- Yimi Vacca -->
          <div class="ns-team-card">
            <div class="ns-team-avatar-wrap">
              <div class="ns-team-avatar-inner">
                <img src={imgYimi.src} alt="Yimi Vacca" class="ns-team-avatar-img" />
              </div>
              <div class="ns-team-badge">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ns-team-badge-icon">
                  <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
            <h3 class="ns-team-name">Yimi Vacca</h3>
            <p class="ns-team-role">CEO &amp; Fundador</p>
            <p class="ns-team-desc">
              Líder estratégico con más de 10 años diseñando soluciones
              tecnológicas innovadoras enfocadas en crecimiento empresarial.
            </p>
          </div>

          <!-- Brayan Jamanoy -->
          <div class="ns-team-card">
            <div class="ns-team-avatar-wrap">
              <div class="ns-team-avatar-inner">
                <img src={imgBrayan.src} alt="Brayan Jamanoy" class="ns-team-avatar-img" />
              </div>
              <div class="ns-team-badge">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ns-team-badge-icon">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              </div>
            </div>
            <h3 class="ns-team-name">Brayan Jamanoy</h3>
            <p class="ns-team-role">CTO &amp; Arquitecto de Software</p>
            <p class="ns-team-desc">
              Especialista en arquitectura de software, automatización y
              sistemas escalables para organizaciones modernas.
            </p>
          </div>

          <!-- Sara Arboleda -->
          <div class="ns-team-card">
            <div class="ns-team-avatar-wrap">
              <div class="ns-team-avatar-inner">
                <img src={imgSara.src} alt="Sara Arboleda" class="ns-team-avatar-img" />
              </div>
              <div class="ns-team-badge">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ns-team-badge-icon">
                  <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                </svg>
              </div>
            </div>
            <h3 class="ns-team-name">Sara Arboleda</h3>
            <p class="ns-team-role">Gestora de Imagen &amp; Medios Digitales</p>
            <p class="ns-team-desc">
              Especialista en branding y gestión de medios digitales para
              potenciar la presencia empresarial.
            </p>
          </div>

          <!-- Diego Benavides -->
          <div class="ns-team-card">
            <div class="ns-team-avatar-wrap">
              <div class="ns-team-avatar-inner">
                <img src={imgDiego.src} alt="Diego Benavides" class="ns-team-avatar-img" />
              </div>
              <div class="ns-team-badge">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ns-team-badge-icon">
                  <path d="M20 18c1.1 0 1.99-.9 1.99-2L22 5c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 5h16v11H4V5z"/>
                </svg>
              </div>
            </div>
            <h3 class="ns-team-name">Diego Benavides</h3>
            <p class="ns-team-role">
              Desarrollador Web &amp; Recolección de Datos
            </p>
            <p class="ns-team-desc">
              Desarrollador de instrumentos digitales para la recolección de
              datos y diseñador de soluciones web.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ TECNOLOGÍAS ═══════════ -->
    <section class="ns-section bg-[#111]">
      <div class="ns-container">
        <p class="ns-tag">TECNOLOGÍA</p>
        <h2 class="ns-heading mb-10">Tecnologías que usamos</h2>

        <div class="ns-tech-servicios">
          {techServicios.map((grupo) => (
            <div class="ns-tech-grupo">
              <div class="ns-tech-grupo__header">
                <span class="ns-tech-grupo__emoji">{grupo.icono}</span>
                <h3 class="ns-tech-grupo__title">{grupo.servicio}</h3>
              </div>
              <div class="ns-tech-grupo__grid">
                {grupo.tecnologias.map((t) => (
                  <div class="ns-tech-item">
                    {t.img ? (
                      <img src={t.img} alt={t.nombre} class="ns-tech-item__img" width="56" height="56" />
                    ) : (
                      <span class="ns-tech-item__label" aria-hidden="true">&#9679;</span>
                    )}
                    <span class="ns-tech-item__name">{t.nombre}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ NUESTRA CULTURA ═══════════ -->
    <section class="ns-section bg-[#0f0f0f]">
      <div class="ns-container">
        <p class="ns-tag text-center">NUESTRA CULTURA</p>
        <h2 class="ns-heading text-center mb-4">
          Crecemos contigo: cultura enfocada en<br />
          <span class="text-[#F39C12]"
            >innovación, aprendizaje y resultados reales</span
          >
        </h2>
        <p class="text-gray-300 text-center max-w-2xl mx-auto mb-14">
          En INNOVA SYSTEMS CENTER creemos que el talento florece cuando tiene
          los recursos correctos. Cada integrante trabaja en proyectos reales
          que generan impacto directo en organizaciones de Colombia y
          Latinoamérica.
        </p>

        <div class="ns-cultura-grid">
          <div class="ns-cultura-card">
            <img src={iconCrece.src} alt="" class="ns-cultura-icon" />
            <h3 class="ns-cultura-title">Crecimiento profesional</h3>
            <p class="ns-cultura-desc">
              Cada proyecto te reta, te enseña y mejora tu nivel técnico con
              resultados reales.
            </p>
          </div>
          <div class="ns-cultura-card">
            <img src={iconColabo.src} alt="" class="ns-cultura-icon" />
            <h3 class="ns-cultura-title">Trabajo colaborativo</h3>
            <p class="ns-cultura-desc">
              Equipos multidisciplinarios con desarrolladores, creativos y
              analistas de datos.
            </p>
          </div>
          <div class="ns-cultura-card">
            <img src={iconInnova.src} alt="" class="ns-cultura-icon" />
            <h3 class="ns-cultura-title">Ambiente innovador</h3>
            <p class="ns-cultura-desc">
              Apostamos por la experimentación, nuevas ideas y tecnología de
              vanguardia.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA / CONTACTO ═══════════ -->
    <section id="contact-form" class="ns-cta">
      <div class="ns-container text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color:#F39C12">
          ¿Listo para automatizar y optimizar tus datos?
        </h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-10">
          Agenda una sesión gratuita y descubre cómo podemos llevar tu empresa
          al siguiente nivel con tecnología real y resultados medibles.
        </p>
        <a
          href="/contacto#formulario-contacto"
          class="ns-btn-primary text-lg px-12 py-4"
          style="color:#fff">Agenda tu sesión</a
        >
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* ─── Variables ─── */
  .ns-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  .ns-section {
    padding: 5rem 1.5rem;
  }
  .ns-tag {
    color: #f39c12;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    display: block;
  }
  .ns-heading {
