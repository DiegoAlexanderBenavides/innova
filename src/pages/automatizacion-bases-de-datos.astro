---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Hero background
import heroBg from '../assets/images/RECURSOS/bases de datos gpt fondo negro.png';

// Galería "Soluciones diseñadas"
import galImg1 from '../assets/images/services/automatizacion_bases_de_datos/db-robustas-personalizadas.png';
import galImg2 from '../assets/images/services/automatizacion_bases_de_datos/db-automatizacion-tiempo-errores.png';
import galImg3 from '../assets/images/services/automatizacion_bases_de_datos/db-integraciones-confiables.png';

// Iconos features
import iconDb      from '../assets/images/RECURSOS/nueva base de datos amarillo.png';
import iconAuto    from '../assets/images/RECURSOS/repetición amarillo.png';
import iconSeguro  from '../assets/images/RECURSOS/verificado amarillo.png';
import iconRend    from '../assets/images/RECURSOS/optimizacion de código blanco.png';

// Caso de uso
import casoImg from '../assets/images/IMÁGENES/makikuna.png';

const pageTitle = "Automatización y Bases de Datos | INNOVA SYSTEMS CENTER – Procesos Inteligentes y Datos Confiables";
const pageDescription = "Automatizamos procesos y gestionamos bases de datos para mejorar eficiencia, reducir errores y asegurar información confiable. Soluciones a medida en MySQL, PostgreSQL, Python y más.";
const pageKeywords = "automatización de procesos, bases de datos, PostgreSQL, MySQL, SQL, MongoDB, automatización empresarial, RPA, flujos automáticos, integración de sistemas, APIs, ETL, optimización de procesos, reducción de tiempos operativos, limpieza de datos, migración de datos, seguridad informática";

const galeria = [
  { img: galImg1.src, label: "Bases de datos robustas y personalizadas" },
  { img: galImg2.src, label: "Automatización para reducir tiempos y errores" },
  { img: galImg3.src, label: "Integraciones confiables con tus sistemas" },
];

const pasos = [
  { num: "01", titulo: "Análisis de datos y procesos",       desc: "Mapeamos el flujo actual de información y definimos los puntos clave de mejora para tu operación." },
  { num: "02", titulo: "Diseño de BD y automatizaciones",    desc: "Creamos estructuras estables y flujos automáticos completamente personalizados a tu empresa." },
  { num: "03", titulo: "Integración con sistemas",           desc: "Conectamos tus datos con plataformas internas, CRM, ERP, APIs o dashboards en tiempo real." },
  { num: "04", titulo: "Optimización y soporte",             desc: "Monitoreamos, ajustamos y aseguramos el rendimiento continuo de cada solución implementada." },
];

const tecnologias = [
  "MySQL", "PostgreSQL", "SQL Server", "ODK",
  "Enketo", "Python", "Node.js", "MongoDB",
];

const faqs = [
  { q: "¿Pueden migrar mi base de datos actual?",    a: "Sí, migramos bases de datos sin perder información. Realizamos el proceso de forma segura, validando la integridad antes y después de la migración." },
  { q: "¿Pueden automatizar tareas internas?",       a: "Sí, automatizamos reportes, flujos internos, registros y cualquier proceso repetitivo que consuma tiempo de tu equipo." },
  { q: "¿Qué tan segura estará mi información?",    a: "Implementamos seguridad robusta: roles de acceso, cifrado de datos, respaldos automáticos y buenas prácticas de seguridad informática." },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main class="ab-main">

    <!-- ══════════════ HERO ══════════════ -->
    <section class="ab-hero" style={`background-image:url('${heroBg.src}')`}>
      <div class="ab-hero__overlay"></div>
      <div class="ab-hero__content">
        <p class="ab-tag">AUTOMATIZACIÓN Y BASES DE DATOS</p>
        <h1 class="ab-hero__title">
          Automatización que elimina errores<br />
          <span class="text-[#F39C12]">y acelera tus procesos</span>
        </h1>
        <p class="ab-hero__sub">
          Sistemas de Automatización y Bases de Datos a Medida
        </p>
        <a href="/contacto#formulario-contacto" class="ab-btn-primary">
          Solicita tu Consultoría Gratuita
        </a>
      </div>
    </section>

    <!-- ══════════════ NUESTRO SERVICIO ══════════════ -->
    <section class="ab-section bg-[#111]">
      <div class="ab-container">
        <p class="ab-tag text-center">AUTOMATIZACIÓN Y BASES DE DATOS PARA EMPRESAS MODERNAS</p>

        <div class="ab-service-grid">
          <!-- Columna izquierda: título + texto -->
          <div class="ab-service-text">
            <h2 class="ab-heading">
              Centraliza tus datos, automatiza procesos y toma
              <span class="text-[#F39C12]">decisiones con precisión</span>
            </h2>
            <p class="text-gray-300 text-base leading-relaxed">
              Diseñamos sistemas de automatización y bases de datos que eliminan tareas manuales,
              reducen errores, protegen tu información y optimizan cada flujo crítico
              dentro de tu organización.
            </p>
          </div>

          <!-- Columna derecha: 4 feature cards -->
          <div class="ab-features">
            <div class="ab-feature-card">
              <img src={iconDb.src} alt="" class="ab-feature-icon" />
              <div>
                <h3 class="ab-feature-title">Datos organizados y accesibles</h3>
                <p class="ab-feature-desc">Estructuras limpias y estables para consultar información sin errores ni duplicados en cualquier momento.</p>
              </div>
            </div>
            <div class="ab-feature-card">
              <img src={iconAuto.src} alt="" class="ab-feature-icon" />
              <div>
                <h3 class="ab-feature-title">Automatización inteligente</h3>
                <p class="ab-feature-desc">Procesos automáticos que reducen tiempos, eliminan tareas repetitivas y mejoran la eficiencia operativa.</p>
              </div>
            </div>
            <div class="ab-feature-card">
              <img src={iconSeguro.src} alt="" class="ab-feature-icon" />
              <div>
                <h3 class="ab-feature-title">Seguridad y control total</h3>
                <p class="ab-feature-desc">Protección de datos, gestión de accesos y cumplimiento de buenas prácticas de seguridad informática.</p>
              </div>
            </div>
            <div class="ab-feature-card">
              <img src={iconRend.src} alt="" class="ab-feature-icon" />
              <div>
                <h3 class="ab-feature-title">Rendimiento optimizado</h3>
                <p class="ab-feature-desc">Bases de datos rápidas, escalables y preparadas para crecer junto con tu negocio sin fricciones.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ GALERÍA — SOLUCIONES ══════════════ -->
    <section class="ab-section bg-[#0a0a0a]">
      <div class="ab-container">
        <p class="ab-tag text-center">A NUESTROS CLIENTES</p>
        <h2 class="ab-heading text-center mb-12">
          Soluciones diseñadas para hacer tu<br />información más útil
        </h2>

        <div class="ab-gallery">
          {galeria.map(g => (
            <div class="ab-gallery-card">
              <div class="ab-gallery-img-wrap">
                <img src={g.img} alt={g.label} class="ab-gallery-img" />
              </div>
              <div class="ab-gallery-badge-wrap">
                <span class="ab-gallery-badge">{g.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ NUESTRO PROCESO ══════════════ -->
    <section class="ab-section bg-[#111]">
      <div class="ab-container">
        <p class="ab-tag text-center">NUESTRO PROCESO</p>
        <h2 class="ab-heading text-center">
          Un proceso claro para automatizar<br />y optimizar tus datos
        </h2>
        <p class="text-center text-gray-300 max-w-2xl mx-auto mb-12">
          Nuestro método garantiza precisión en la información, integraciones sólidas
          y automatizaciones que realmente funcionan desde el primer día.
        </p>

        <div class="ab-steps">
          {pasos.map(p => (
            <div class="ab-step-card">
              <span class="ab-step-num">{p.num}</span>
              <div class="ab-step-text">
                <h3 class="ab-step-title">{p.titulo}</h3>
                <p class="ab-step-desc">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ TECNOLOGÍAS ══════════════ -->
    <section class="ab-section bg-[#0a0a0a]">
      <div class="ab-container">
        <div class="ab-tech-grid">
          <!-- Texto izquierda -->
          <div class="ab-tech-text">
            <p class="ab-tag">TECNOLOGÍAS</p>
            <h2 class="ab-heading">
              Tecnologías para automatización<br />y bases de datos
            </h2>
            <p class="text-gray-300 text-base leading-relaxed">
              Utilizamos tecnologías modernas, estables y confiables para garantizar
              velocidad, seguridad y escalabilidad en cada solución que entregamos.
              Elegimos la herramienta correcta para cada necesidad.
            </p>
          </div>

          <!-- Grid de tecnologías derecha -->
          <div class="ab-tech-badges">
            {tecnologias.map(t => (
              <div class="ab-tech-badge">{t}</div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ CASO DE USO ══════════════ -->
    <section class="ab-section bg-[#111]">
      <div class="ab-container">
        <p class="ab-tag text-center">PROYECCIONES</p>
        <h2 class="ab-heading text-center mb-12">
          Resultados reales con automatización y datos
        </h2>
        <p class="text-center text-gray-300 max-w-2xl mx-auto mb-12">
          Soluciones que mejoraron precisión, tiempos operativos y toma de decisiones
          dentro de organizaciones reales que confiaron en nosotros.
        </p>

        <div class="ab-caso">
          <div class="ab-caso-img-wrap">
            <img src={casoImg.src} alt="Fundación Makikuna" class="ab-caso-img" />
          </div>
          <div class="ab-caso-body">
            <div class="ab-caso-bar"></div>
            <h3 class="ab-caso-title">
              Gestión de Datos para la Fundación Makikuna
            </h3>
            <p class="ab-caso-client">Fundación Makikuna</p>
            <p class="ab-caso-desc">
              Automatización de sistemas de datos (registro, análisis y visualización) para la
              recolección eficiente y el entendimiento profundo de la información estratégica
              de la fundación, con dashboards en tiempo real.
            </p>
            <a href="/fundacion-makikuna-gestion-de-datos" class="ab-link mt-4 inline-block">
              Ver caso completo →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ FAQ ══════════════ -->
    <section class="ab-section bg-[#0a0a0a]">
      <div class="ab-container ab-container--narrow">
        <h2 class="ab-heading text-center mb-4">Preguntas frecuentes</h2>
        <p class="text-center text-gray-400 mb-12">
          Resolvemos las dudas más comunes sobre automatización y bases de datos.
        </p>

        <div id="ab-faq-list" class="space-y-4">
          {faqs.map((f, i) => (
            <div class="ab-faq-item" data-faq={i}>
              <button class="ab-faq-btn" type="button">
                <span>{f.q}</span>
                <svg class="ab-faq-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="ab-faq-answer">{f.a}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ CTA FINAL ══════════════ -->
    <section class="ab-cta">
      <div class="ab-container text-center">
        <p class="ab-tag" style="display:flex; justify-content:center;">¿LISTO PARA AUTOMATIZAR Y OPTIMIZAR TUS DATOS?</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Agenda una sesión con nuestro equipo y descubre cómo<br />
          <span class="text-[#F39C12]">la automatización transforma tu negocio</span>
        </h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-10">
          Hay un mundo de posibilidades esperándote. Cuéntanos tu proyecto y
          cómo podemos optimizar tus procesos y datos para que escales más rápido.
        </p>
        <a href="/contacto#formulario-contacto" class="ab-btn-primary ab-btn-primary--lg">
          Agenda una Sesión
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  /* ── Base ── */
  .ab-main        { min-height: 100vh; display: flex; flex-direction: column; background: #0a0a0a; color: #fff; }
  .ab-container   { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; width: 100%; }
  .ab-container--narrow { max-width: 780px; }
  .ab-section     { padding: 5rem 1.5rem; }

  .ab-tag {
    color: #F39C12; font-weight: 700; font-size: 0.78rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    margin-bottom: 0.75rem; display: block;
  }
  .ab-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800; color: #fff; line-height: 1.2; margin-bottom: 1.25rem;
  }
  .ab-link       { color: #F39C12; font-weight: 600; text-decoration: none; }
  .ab-link:hover { text-decoration: underline; }

  /* ── Botón primario ── */
  .ab-btn-primary {
    display: inline-block;
    background: #F39C12; color: #000;
    font-weight: 700; font-size: 0.95rem;
    padding: 0.85rem 2rem; border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.25s, transform 0.2s;
  }
  .ab-btn-primary:hover { background: #ffc04a; transform: scale(1.04); }
  .ab-btn-primary--lg   { font-size: 1.05rem; padding: 1rem 2.8rem; }

  /* ── Hero ── */
  .ab-hero {
    position: relative; min-height: 100vh;
    background-size: cover; background-position: center;
    background-repeat: no-repeat;
    display: flex; align-items: center;
  }
  .ab-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(120deg, rgba(0,0,0,0.78) 55%, rgba(5,0,10,0.45) 100%);
    z-index: 1;
  }
  .ab-hero__content {
    position: relative; z-index: 2;
    max-width: 1200px; margin: 0 auto; padding: 8rem 1.5rem 4rem;
    text-align: left;
  }
  .ab-hero__title {
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 900; line-height: 1.15; margin-bottom: 1rem; color: #fff;
  }
  .ab-hero__sub {
    color: #ddd; font-size: 1.15rem; margin-bottom: 2rem; max-width: 480px;
  }

  /* ── Servicio grid ── */
  .ab-service-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 3.5rem; align-items: start; margin-top: 1.5rem;
  }
  @media (max-width: 860px) { .ab-service-grid { grid-template-columns: 1fr; gap: 2rem; } }

  /* ── Feature cards ── */
  .ab-features { display: flex; flex-direction: column; gap: 1rem; }
  .ab-feature-card {
    display: flex; align-items: flex-start; gap: 1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(243,156,18,0.18);
    border-radius: 0.9rem; padding: 1rem 1.2rem;
    transition: border-color 0.3s, background 0.3s;
  }
  .ab-feature-card:hover {
    border-color: rgba(243,156,18,0.5);
    background: rgba(243,156,18,0.06);
  }
  .ab-feature-icon  { width: 36px; height: 36px; object-fit: contain; flex-shrink: 0; margin-top: 2px; }
  .ab-feature-title { color: #fff; font-weight: 700; font-size: 0.93rem; margin-bottom: 0.25rem; }
  .ab-feature-desc  { color: #9ca3af; font-size: 0.8rem; line-height: 1.5; }

  /* ── Galería 3 imágenes ── */
  .ab-gallery {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem;
  }
  @media (max-width: 768px) { .ab-gallery { grid-template-columns: 1fr; } }

  .ab-gallery-card {
    border-radius: 0.85rem; overflow: hidden;
    background: #1a1a1a; border: 1px solid rgba(243,156,18,0.15);
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex; flex-direction: column;
  }
  .ab-gallery-card:hover { transform: translateY(-5px); box-shadow: 0 8px 32px rgba(243,156,18,0.2); }
  .ab-gallery-img-wrap { overflow: hidden; }
  .ab-gallery-img   { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform 0.4s; }
  .ab-gallery-card:hover .ab-gallery-img { transform: scale(1.06); }
  .ab-gallery-badge-wrap { padding: 0.8rem 1rem; }
  .ab-gallery-badge {
    display: inline-block; background: #F39C12; color: #fff;
    font-size: 0.73rem; font-weight: 700;
    padding: 0.3rem 0.8rem; border-radius: 999px;
    line-height: 1.4; text-align: center;
  }

  /* ── Pasos del proceso 2×2 ── */
  .ab-steps {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem;
  }
  @media (max-width: 640px) { .ab-steps { grid-template-columns: 1fr; } }

  .ab-step-card {
    background: #1a1a1a;
    border: 1px solid rgba(243,156,18,0.15);
    border-radius: 1rem;
    display: flex; align-items: center; gap: 1.2rem;
    padding: 1.5rem 1.4rem;
    transition: border-color 0.3s, transform 0.3s;
  }
  .ab-step-card:hover { border-color: #F39C12; transform: translateY(-4px); }

  .ab-step-num {
    font-size: 2.2rem; font-weight: 900; color: #F39C12;
    line-height: 1; flex-shrink: 0; min-width: 52px;
  }
  .ab-step-title { color: #fff; font-size: 0.98rem; font-weight: 700; margin-bottom: 0.4rem; }
  .ab-step-desc  { color: #9ca3af; font-size: 0.82rem; line-height: 1.5; }

  /* ── Tecnologías ── */
  .ab-tech-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: center;
  }
  @media (max-width: 768px) { .ab-tech-grid { grid-template-columns: 1fr; gap: 2.5rem; } }

  .ab-tech-badges {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem;
  }
  .ab-tech-badge {
    background: #1a1a1a;
    border: 1px solid rgba(243,156,18,0.2);
    border-radius: 0.75rem;
    padding: 1rem 1.2rem;
    color: #fff; font-weight: 600; font-size: 0.95rem;
    text-align: center;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
    cursor: default;
  }
  .ab-tech-badge:hover {
    border-color: #F39C12;
    background: rgba(243,156,18,0.08);
    transform: translateY(-3px);
  }

  /* ── Caso de uso ── */
  .ab-caso {
    display: grid; grid-template-columns: 340px 1fr;
    gap: 2.5rem; align-items: center;
    background: #1a1a1a;
    border: 1px solid rgba(243,156,18,0.2);
    border-radius: 1.1rem; overflow: hidden;
    max-width: 860px; margin: 0 auto;
  }
  @media (max-width: 700px) { .ab-caso { grid-template-columns: 1fr; } }
  .ab-caso-img-wrap { overflow: hidden; height: 100%; min-height: 260px; }
  .ab-caso-img      { width: 100%; height: 100%; object-fit: cover; min-height: 260px; transition: transform 0.4s; }
  .ab-caso-img-wrap:hover .ab-caso-img { transform: scale(1.05); }
  .ab-caso-body  { padding: 2rem 2rem 2rem 0.5rem; position: relative; }
  @media (max-width: 700px) { .ab-caso-body { padding: 1.5rem; } }
  .ab-caso-bar   { width: 100%; height: 3px; background: #F39C12; margin-bottom: 1.25rem; border-radius: 2px; }
  .ab-caso-title  { color: #fff; font-size: 1.15rem; font-weight: 800; margin-bottom: 0.4rem; line-height: 1.35; }
  .ab-caso-client { color: #F39C12; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.75rem; }
  .ab-caso-desc   { color: #9ca3af; font-size: 0.88rem; line-height: 1.6; }

  /* ── FAQ ── */
  .ab-faq-item {
    background: #1a1a1a;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.8rem; overflow: hidden;
    transition: border-color 0.3s;
  }
  .ab-faq-item.open { border-color: rgba(243,156,18,0.4); }
  .ab-faq-btn {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    padding: 1.1rem 1.25rem; background: none; border: none; cursor: pointer;
    color: #fff; font-size: 0.97rem; font-weight: 600; text-align: left; gap: 1rem;
  }
  .ab-faq-arrow {
    width: 20px; height: 20px; color: #F39C12; flex-shrink: 0; transition: transform 0.3s;
  }
  .ab-faq-item.open .ab-faq-arrow { transform: rotate(180deg); }
  .ab-faq-answer {
    max-height: 0; overflow: hidden;
    color: #9ca3af; font-size: 0.88rem; line-height: 1.6;
    transition: max-height 0.35s ease, padding 0.3s;
    padding: 0 1.25rem;
  }
  .ab-faq-item.open .ab-faq-answer { max-height: 200px; padding: 0 1.25rem 1.1rem; }

  /* ── CTA Final ── */
  .ab-cta {
    padding: 5rem 1.5rem;
    background: linear-gradient(135deg, #0a0a0a 0%, #0d0a1a 50%, #0a0a0a 100%);
    text-align: center;
  }
</style>

<script>
  document.querySelectorAll('.ab-faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.ab-faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.ab-faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });
</script>
