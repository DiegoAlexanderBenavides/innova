---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Import target assets
import heroImg from '../assets/images/makikuna-video/hero_video_icon.png';
import previewImg from '../assets/images/makikuna-video/video_preview_forest.png';
import videoosImg from '../assets/images/makikuna-video/videoos.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pageTitle = "Caso de Éxito – Casa del Bosque | Producción y Edición de Video | INNOVA SYSTEMS CENTER";
const pageDescription = "Descubre cómo INNOVA SYSTEMS CENTER llevó a cabo la producción audiovisual y animación 2D del video educativo Casa del Bosque para la Fundación Makikuna.";
const pageKeywords = "caso de éxito, producción audiovisual, animación 2D, edición de video, diseño audiovisual, producción digital, Innova Systems Center, videos para educación, multimedia, aprendizaje interactivo, postproducción de video";
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />
  
  <main class="min-h-screen bg-[#080808] text-white font-sans overflow-hidden">
    
    <!-- ── HERO SECTION ── -->
    <section id="inicio" class="relative pt-36 pb-20 md:py-40 overflow-hidden flex items-center min-h-screen bg-radial-glow">
      <div class="cb-spotlight spotlight-1"></div>
      <div class="cb-spotlight spotlight-2"></div>
      
      <div class="max-w-[1240px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10 w-full">
        
        <!-- Left Side Content -->
        <div class="flex flex-col text-left">
          <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em] mb-4">Caso de Éxito</span>
          <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-[1.1] mb-6 tracking-tight">
            Producción Audiovisual<br />
            <span class="text-[#F39C12]">Casa del Bosque</span>
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-normal leading-relaxed mb-8 max-w-lg">
            Conceptualización, animación 2D y postproducción de video educativo de alta calidad desarrollado por el equipo técnico de INNOVA.
          </p>

          <!-- Buttons -->
          <div class="flex flex-wrap gap-4 mb-12">
            <a href="#sobre-el-proyecto" class="bg-[#F39C12] text-black font-extrabold px-8 py-3.5 rounded-full hover:bg-[#ffb339] transition-all flex items-center gap-3 transform hover:scale-105 shadow-xl shadow-[#F39C12]/25">
              Ver detalles técnicos
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <!-- Micro Features Under Hero -->
          <div class="grid grid-cols-3 gap-4 border-t border-gray-800/60 pt-8 max-w-lg">
            <div class="flex flex-col items-start text-left">
              <svg class="w-6 h-6 text-[#F39C12] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M15 10l5 5-5 5M4 4v7a4 4 0 004 4h12" />
              </svg>
              <span class="text-xs text-gray-400 font-medium leading-tight">Proceso ágil</span>
            </div>
            <div class="flex flex-col items-start text-left">
              <svg class="w-6 h-6 text-[#F39C12] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9.663 17h4.673M12 3v1m6.364 1.364l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 113.536 0V21h2v-4.343z" />
              </svg>
              <span class="text-xs text-gray-400 font-medium leading-tight">Ilustración digital</span>
            </div>
            <div class="flex flex-col items-start text-left">
              <svg class="w-6 h-6 text-[#F39C12] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
              <span class="text-xs text-gray-400 font-medium leading-tight">Sonorización HD</span>
            </div>
          </div>

        </div>

        <!-- Right Side Video Player (Premium Mockup) -->
        <div class="flex justify-center relative w-full lg:max-w-xl mx-auto">
          <!-- Outer border/shadow glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-[#F39C12] to-[#ffb339] rounded-2xl blur-xl opacity-20 animate-pulse"></div>
          
          <div class="relative z-10 w-full overflow-hidden rounded-2xl border-2 border-[#F39C12]/30 shadow-2xl bg-black">
            <img src={videoosImg.src} alt="Casa del Bosque - Caso de éxito" class="w-full h-auto object-cover max-h-[400px] transition-transform duration-500 hover:scale-[1.02]" />
          </div>
        </div>

      </div>
    </section>

    <!-- ── SOBRE EL PROYECTO SECTION ── -->
    <section id="sobre-el-proyecto" class="py-24 bg-[#0d0d0d] border-t border-gray-900 relative">
      <div class="max-w-[1240px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- Left Side Content -->
        <div class="flex flex-col text-left">
          <div class="flex items-center gap-4 mb-4">
            <img src={heroImg.src} alt="" class="w-12 h-12 object-contain" />
            <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em]">El Trabajo Realizado</span>
          </div>
          <h2 class="text-3xl md:text-5xl font-extrabold text-white leading-tight mb-6">
            Creatividad y técnica de <span class="text-[#F39C12]">INNOVA</span>
          </h2>
          <p class="text-gray-300 text-lg leading-relaxed mb-8">
            Diseñamos una solución audiovisual integral que incluye la redacción de guión técnico, la ilustración digital de escenarios y personajes, y la postproducción final de audio y video. El resultado es un producto digital fluido, dinámico y de gran valor educativo.
          </p>
          <a href="#lo-que-logramos" class="self-start border border-[#F39C12] text-white hover:bg-[#F39C12] hover:text-black font-bold px-8 py-3 rounded-full transition-all duration-300">
            Ver hitos alcanzados
          </a>
        </div>

        <!-- Right Side Ficha Técnica Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all text-left">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Cliente</span>
            <span class="text-base text-white font-bold block">Casa del Bosque</span>
          </div>

          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all text-left">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Servicio prestado</span>
            <span class="text-base text-white font-bold block">Producción & Edición Digital</span>
          </div>

          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all text-left">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Tecnología</span>
            <span class="text-base text-white font-bold block">Animación 2D & Sonorización</span>
          </div>

          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all text-left">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Calidad de Entrega</span>
            <span class="text-base text-white font-bold block">Full HD 1080p con Subtítulos</span>
          </div>
          
        </div>

      </div>
    </section>

    <!-- ── LO QUE LOGRAMOS SECTION ── -->
    <section id="lo-que-logramos" class="py-24 bg-[#080808] border-t border-gray-900">
      <div class="max-w-[1240px] mx-auto px-6">
        
        <div class="text-center mb-16">
          <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em] mb-3 block">Lo que logramos</span>
          <h2 class="text-3xl md:text-5xl font-extrabold text-white">
            Resultados de nuestra <span class="text-[#F39C12]">producción</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Hito 1 -->
          <div class="bg-[#121212] border border-gray-800 rounded-2xl p-8 flex flex-col text-left transition-all duration-300 hover:border-[#F39C12]/40 hover:-translate-y-1">
            <div class="mb-6 text-[#F39C12]">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white mb-3">Guión y Estructura Educativa</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Planificación técnica de escenas y diálogos optimizados para mantener el interés del espectador y asegurar la claridad del mensaje.
            </p>
          </div>

          <!-- Hito 2 -->
          <div class="bg-[#121212] border border-gray-800 rounded-2xl p-8 flex flex-col text-left transition-all duration-300 hover:border-[#F39C12]/40 hover:-translate-y-1">
            <div class="mb-6 text-[#F39C12]">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white mb-3">Ilustraciones y Escenarios 2D</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Desarrollo visual con una paleta de colores vibrante, ilustraciones personalizadas y personajes amigables adaptados a la audiencia.
            </p>
          </div>

          <!-- Hito 3 -->
          <div class="bg-[#121212] border border-gray-800 rounded-2xl p-8 flex flex-col text-left transition-all duration-300 hover:border-[#F39C12]/40 hover:-translate-y-1">
            <div class="mb-6 text-[#F39C12]">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white mb-3">Postproducción y Sonido</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Edición de audio digital, integración de voces profesionales (voice-over) y musicalización de fondo con efectos ambientales.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- ── NUESTRO PROCESO DE PRODUCCIÓN ── -->
    <section class="py-24 bg-[#0d0d0d] border-t border-gray-900">
      <div class="max-w-[1240px] mx-auto px-6">
        
        <div class="text-center mb-16">
          <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em] mb-3 block">El Proceso</span>
          <h2 class="text-3xl md:text-5xl font-extrabold text-white">
            Cómo creamos el <span class="text-[#F39C12]">material</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Paso 1 -->
          <div class="bg-[#121212] border border-gray-800 rounded-2xl p-6 text-left hover:border-[#F39C12]/40 transition-colors">
            <span class="text-[#F39C12] text-3xl font-black block mb-4">01</span>
            <h4 class="text-base font-bold text-white mb-2">Guión y Estructura</h4>
            <p class="text-gray-400 text-xs leading-relaxed">
              Definición de las ideas clave, estructuración de la narrativa y redacción de diálogos didácticos.
            </p>
          </div>

          <!-- Paso 2 -->
          <div class="bg-[#121212] border border-gray-800 rounded-2xl p-6 text-left hover:border-[#F39C12]/40 transition-colors">
            <span class="text-[#F39C12] text-3xl font-black block mb-4">02</span>
            <h4 class="text-base font-bold text-white mb-2">Diseño y Storyboard</h4>
            <p class="text-gray-400 text-xs leading-relaxed">
              Esquematización visual de cada escena, bocetado de personajes y preparación de fondos.
            </p>
          </div>

          <!-- Paso 3 -->
          <div class="bg-[#121212] border border-gray-800 rounded-2xl p-6 text-left hover:border-[#F39C12]/40 transition-colors">
            <span class="text-[#F39C12] text-3xl font-black block mb-4">03</span>
            <h4 class="text-base font-bold text-white mb-2">Animación Digital</h4>
            <p class="text-gray-400 text-xs leading-relaxed">
              Movimiento de elementos visuales en 2D, transiciones entre escenas y renderizado de animaciones.
            </p>
          </div>

          <!-- Paso 4 -->
          <div class="bg-[#121212] border border-gray-800 rounded-2xl p-6 text-left hover:border-[#F39C12]/40 transition-colors">
            <span class="text-[#F39C12] text-3xl font-black block mb-4">04</span>
            <h4 class="text-base font-bold text-white mb-2">Sonorización y Master</h4>
            <p class="text-gray-400 text-xs leading-relaxed">
              Grabación y ecualización de voz en off, sincronía de efectos y exportación en alta definición.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- ── CTA SECCIÓN ── -->
    <section class="py-24 bg-[#080808] border-t border-gray-900">
      <div class="max-w-[800px] mx-auto px-6 text-center">
        <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em] mb-4 block">¿Tienes un proyecto en mente?</span>
        <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6">
          Lleva tu contenido al <span class="text-[#F39C12]">siguiente nivel</span>
        </h2>
        <p class="text-gray-400 text-base leading-relaxed mb-8">
          En INNOVA SYSTEMS CENTER creamos soluciones multimedia, videos profesionales y animaciones adaptadas a las necesidades de tu empresa o fundación.
        </p>
        <a href={`${base}/contacto#formulario-contacto`} class="bg-[#F39C12] text-black font-extrabold px-8 py-3.5 rounded-full hover:bg-[#ffb339] transition-all inline-block transform hover:scale-105 shadow-xl shadow-[#F39C12]/25">
          Cotiza tu producción audiovisual
        </a>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>

<style is:global>
  /* ── BACKGROUND SPOTLIGHT EFFECTS ── */
  .bg-radial-glow {
    background: radial-gradient(circle at 75% 50%, rgba(243, 156, 18, 0.05) 0%, rgba(8, 8, 8, 1) 70%);
  }
  .cb-spotlight {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.45;
  }
  .spotlight-1 {
    width: 400px;
    height: 400px;
    background: rgba(243, 156, 18, 0.1);
    top: 10%;
    right: 5%;
  }
  .spotlight-2 {
    width: 300px;
    height: 300px;
    background: rgba(243, 156, 18, 0.06);
    bottom: 20%;
    left: 5%;
  }
</style>
