---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Import target assets
import heroImg from '../assets/images/makikuna-video/hero_video_icon.png';
import previewImg from '../assets/images/makikuna-video/video_preview_forest.png';
import iconBosque from '../assets/images/makikuna-video/icon_bosque.png';
import iconBiodiversidad from '../assets/images/makikuna-video/icon_biodiversidad.png';
import iconServicios from '../assets/images/makikuna-video/icon_servicios.png';
import iconAmenazas from '../assets/images/makikuna-video/icon_amenazas.png';
import iconAcciones from '../assets/images/makikuna-video/icon_acciones.png';
import docentesBanner from '../assets/images/makikuna-video/docentes_banner.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pageTitle = "Caso de Éxito – Casa del Bosque | Producción de Video Educativo Infantil | INNOVA SYSTEMS CENTER";
const pageDescription = "Descubre cómo INNOVA SYSTEMS CENTER creó un video educativo infantil para Casa del Bosque, combinando animación, narrativa y diseño audiovisual para generar aprendizaje dinámico y atractivo para niños.";
const pageKeywords = "caso de éxito, producción audiovisual, video educativo infantil, contenido infantil, animación para niños, storytelling infantil, edición de video, diseño audiovisual, producción digital, contenido educativo, Casa del Bosque, Fabrica Cuentos, Innova Systems Center, videos para educación, creatividad infantil, multimedia, diseño de contenido para niños, aprendizaje interactivo, producción de contenido educativo, video narrativo infantil, animación infantil Colombia";
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />
  
  <main class="min-h-screen bg-[#080808] text-white font-sans overflow-hidden">
    
    <!-- ── HERO SECTION ── -->
    <section id="inicio" class="relative pt-36 pb-20 md:py-40 overflow-hidden flex items-center min-h-screen bg-radial-glow">
      <div class="cb-spotlight spotlight-1"></div>
      <div class="cb-spotlight spotlight-2"></div>
      
      <div class="max-w-[1240px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10 w-full">
        
        <!-- Left Side Content -->
        <div class="flex flex-col text-left">
          <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em] mb-4">Caso de Éxito</span>
          <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-[1.1] mb-6 tracking-tight">
            Casa del Bosque<br />
            <span class="text-[#F39C12]">Video Educativo</span>
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-normal leading-relaxed mb-8 max-w-lg">
            Una producción educativa que invita a niñas, niños y jóvenes a descubrir la importancia de los bosques para la vida y nuestro futuro.
          </p>

          <!-- Buttons -->
          <div class="flex flex-wrap gap-4 mb-12">
            <a href="#sobre-el-proyecto" class="bg-[#F39C12] text-black font-extrabold px-8 py-3.5 rounded-full hover:bg-[#ffb339] transition-all flex items-center gap-3 transform hover:scale-105 shadow-xl shadow-[#F39C12]/25">
              Conocer ficha técnica
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <!-- Micro Features Under Hero -->
          <div class="grid grid-cols-3 gap-4 border-t border-gray-800/60 pt-8 max-w-lg">
            <div class="flex flex-col items-start text-left">
              <svg class="w-6 h-6 text-[#F39C12] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                <path d="M12 6v12M6 12h12"/>
              </svg>
              <span class="text-xs text-gray-400 font-medium leading-tight">Aprende sobre los bosques</span>
            </div>
            <div class="flex flex-col items-start text-left">
              <svg class="w-6 h-6 text-[#F39C12] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <span class="text-xs text-gray-400 font-medium leading-tight">Conoce su importancia</span>
            </div>
            <div class="flex flex-col items-start text-left">
              <svg class="w-6 h-6 text-[#F39C12] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              <span class="text-xs text-gray-400 font-medium leading-tight">Actúa por un mejor futuro</span>
            </div>
          </div>

        </div>

        <!-- Right Side Video Player (Premium Mockup) -->
        <div class="flex justify-center relative w-full lg:max-w-xl mx-auto">
          <!-- Outer border/shadow glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-[#F39C12] to-[#ffb339] rounded-2xl blur-xl opacity-20 animate-pulse"></div>
          
          <div class="relative z-10 w-full overflow-hidden rounded-2xl border-2 border-[#F39C12]/30 shadow-2xl bg-black">
            <!-- Video Player -->
            <video id="video-hero-player" class="w-full h-auto object-cover max-h-[400px]" controls poster={previewImg.src}>
              <source src="https://innovasystemscenter.com/assets/videos/casa_bosque_video.mp4" type="video/mp4" />
              <source src={`${base}/assets/videos/casa_bosque_video.mp4`} type="video/mp4" />
              <source src="/assets/videos/casa_bosque_video.mp4" type="video/mp4" />
              Tu navegador no soporta videos HTML5.
            </video>
          </div>
        </div>

      </div>
    </section>

    <!-- ── SOBRE EL PROYECTO SECTION ── -->
    <section id="sobre-el-proyecto" class="py-24 bg-[#0d0d0d] border-t border-gray-900 relative">
      <div class="max-w-[1240px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- Left Side Content -->
        <div class="flex flex-col text-left">
          <div class="flex items-center gap-4 mb-4">
            <img src={heroImg.src} alt="" class="w-12 h-12 object-contain" />
            <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em]">Sobre el proyecto</span>
          </div>
          <h2 class="text-3xl md:text-5xl font-extrabold text-white leading-tight mb-6">
            Educación que <span class="text-[#F39C12]">inspira y transforma</span>
          </h2>
          <p class="text-gray-300 text-lg leading-relaxed mb-8">
            Casa del Bosque es un video educativo de alta calidad desarrollado por INNOVA SYSTEMS CENTER para la Fundación Makikuna. Busca fomentar la conciencia ambiental a través de historias cercanas, lenguaje claro y contenido audiovisual dinámico que capta la atención de los niños y promueve la conservación de nuestros recursos naturales.
          </p>
          <a href="#temas" class="self-start border border-[#F39C12] text-white hover:bg-[#F39C12] hover:text-black font-bold px-8 py-3 rounded-full transition-all duration-300">
            Ver temas de aprendizaje
          </a>
        </div>

        <!-- Right Side Ficha Técnica Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Cliente</span>
            <span class="text-base text-white font-bold block">Fundación Makikuna</span>
          </div>

          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Tipo de Proyecto</span>
            <span class="text-base text-white font-bold block">Producción de Video Educativo</span>
          </div>

          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Formato</span>
            <span class="text-base text-white font-bold block">Animación Digital 2D & Narrativa</span>
          </div>

          <div class="bg-[#121212] border border-gray-800 rounded-xl p-5 hover:border-[#F39C12]/30 transition-all">
            <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider block mb-1">Público Objetivo</span>
            <span class="text-base text-white font-bold block">Infantil, Juvenil y Docentes</span>
          </div>
          
        </div>

      </div>
    </section>

    <!-- ── TEMAS QUE ENCONTRARÁS SECTION ── -->
    <section id="temas" class="py-24 bg-[#080808] relative">
      <div class="max-w-[1240px] mx-auto px-6">
        
        <!-- Header -->
        <div class="text-center mb-16">
          <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em] mb-3 block">Temas que encontrarás</span>
          <h2 class="text-3xl md:text-5xl font-extrabold text-white">
            Explora. <span class="text-[#F39C12]">Aprende.</span> Actúa.
          </h2>
        </div>

        <!-- Grid of 5 Cards -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-6 mb-12">
          
          <!-- Card 1 -->
          <div class="cb-card group">
            <div class="cb-card__icon-wrap">
              <img src={iconBosque.src} alt="¿Qué es un bosque?" class="w-14 h-14 object-contain group-hover:scale-110 transition-transform" />
            </div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider text-center group-hover:text-[#F39C12] transition-colors">
              ¿Qué es<br />un bosque?
            </h3>
          </div>

          <!-- Card 2 -->
          <div class="cb-card group">
            <div class="cb-card__icon-wrap">
              <img src={iconBiodiversidad.src} alt="Biodiversidad" class="w-14 h-14 object-contain group-hover:scale-110 transition-transform" />
            </div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider text-center group-hover:text-[#F39C12] transition-colors">
              Biodiversidad
            </h3>
          </div>

          <!-- Card 3 -->
          <div class="cb-card group">
            <div class="cb-card__icon-wrap">
              <img src={iconServicios.src} alt="Servicios ambientales" class="w-14 h-14 object-contain group-hover:scale-110 transition-transform" />
            </div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider text-center group-hover:text-[#F39C12] transition-colors">
              Servicios<br />ambientales
            </h3>
          </div>

          <!-- Card 4 -->
          <div class="cb-card group">
            <div class="cb-card__icon-wrap">
              <img src={iconAmenazas.src} alt="Amenazas y cuidados" class="w-14 h-14 object-contain group-hover:scale-110 transition-transform" />
            </div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider text-center group-hover:text-[#F39C12] transition-colors">
              Amenazas<br />y cuidados
            </h3>
          </div>

          <!-- Card 5 -->
          <div class="cb-card group">
            <div class="cb-card__icon-wrap">
              <img src={iconAcciones.src} alt="Acciones para un futuro mejor" class="w-14 h-14 object-contain group-hover:scale-110 transition-transform" />
            </div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider text-center group-hover:text-[#F39C12] transition-colors">
              Acciones para<br />un futuro mejor
            </h3>
          </div>

        </div>

        <!-- Centered button -->
        <div class="text-center">
          <a href="#recursos" class="inline-block border border-[#F39C12] text-white hover:bg-[#F39C12] hover:text-black font-bold px-8 py-3 rounded-full transition-all duration-300">
            Ver recursos para docentes
          </a>
        </div>

      </div>
    </section>

    <!-- ── RECURSOS Y COMPROMISO AMBIENTAL ── -->
    <section id="recursos" class="py-20 bg-[#080808]">
      <div class="max-w-[1240px] mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          
          <!-- Left: Recursos didácticos (Para Docentes) - 7 cols -->
          <div class="lg:col-span-7 bg-gradient-to-br from-[#111111] to-[#171106] border border-gray-800 rounded-3xl p-8 md:p-12 flex flex-col justify-between shadow-2xl relative overflow-hidden group">
            <!-- Decorative gradient blur -->
            <div class="absolute -right-20 -bottom-20 w-60 h-60 bg-[#F39C12]/5 rounded-full blur-3xl group-hover:bg-[#F39C12]/10 transition-all duration-500"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row gap-8 items-center h-full">
              <!-- Text content -->
              <div class="flex-1 flex flex-col text-left justify-between h-full">
                <div>
                  <span class="text-[#F39C12] font-bold text-xs uppercase tracking-[0.2em] mb-3 block">Para Docentes</span>
                  <h3 class="text-2xl md:text-3xl font-extrabold text-white leading-tight mb-4">
                    Materiales didácticos y actividades
                  </h3>
                  <p class="text-gray-300 text-sm leading-relaxed mb-6">
                    Lleva el aprendizaje más lejos con guías didácticas, talleres y recursos descargables diseñados especialmente para complementar el video en el aula.
                  </p>
                </div>
                <a href={`${base}/contacto#formulario-contacto`} class="self-start border border-[#F39C12] text-white hover:bg-[#F39C12] hover:text-black font-bold px-6 py-2.5 rounded-full transition-all duration-300">
                  Acceder a recursos
                </a>
              </div>
              
              <!-- Banner image inside resource card -->
              <div class="w-full max-w-[200px] flex-shrink-0">
                <img src={docentesBanner.src} alt="Docentes banner" class="w-full h-auto rounded-xl shadow-lg border border-gray-800/40 transform group-hover:scale-102 transition-transform duration-300" />
              </div>
            </div>
          </div>

          <!-- Right: Compromiso Ambiental (Cuidemos hoy los bosques) - 5 cols -->
          <div class="lg:col-span-5 bg-gradient-to-br from-[#140d00] to-[#0A0A0A] border border-[#F39C12]/15 rounded-3xl p-8 md:p-12 flex flex-col justify-between shadow-2xl relative overflow-hidden group">
            <div class="absolute -left-10 -top-10 w-40 h-40 bg-[#F39C12]/5 rounded-full blur-2xl"></div>
            
            <div class="relative z-10 flex flex-col h-full justify-between text-left">
              <div>
                <div class="w-12 h-12 bg-[#F39C12]/10 rounded-full flex items-center justify-center text-[#F39C12] border border-[#F39C12]/20 mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    <path d="M2 12h20"/>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">Cuidemos hoy los bosques</h3>
                <p class="text-gray-400 text-sm leading-relaxed mb-6">
                  Para disfrutar mañana un mundo mejor. Proteger el medio ambiente es una tarea colectiva que comienza con la educación de los más jóvenes.
                </p>
              </div>
              
              <a href={`${base}/contacto#formulario-contacto`} class="bg-[#F39C12] text-black font-extrabold px-6 py-3 rounded-full hover:bg-[#ffb339] transition-all flex items-center justify-center gap-2 text-sm shadow-lg shadow-[#F39C12]/25">
                Iniciar consultoría ambiental
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>

<style is:global>
  /* ── BACKGROUND SPOTLIGHT EFFECTS ── */
  .bg-radial-glow {
    background: radial-gradient(circle at 75% 50%, rgba(243, 156, 18, 0.05) 0%, rgba(8, 8, 8, 1) 70%);
  }
  .cb-spotlight {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.45;
  }
  .spotlight-1 {
    width: 400px;
    height: 400px;
    background: rgba(243, 156, 18, 0.1);
    top: 10%;
    right: 5%;
  }
  .spotlight-2 {
    width: 300px;
    height: 300px;
    background: rgba(243, 156, 18, 0.06);
    bottom: 20%;
    left: 5%;
  }

  /* ── FLOATING ANIMATION ── */
  .animate-float {
    animation: cbFloat 6s ease-in-out infinite;
  }
  @keyframes cbFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-15px); }
  }

  /* ── TEMAS CARDS ── */
  .cb-card {
    background: #111;
    border: 1px solid rgba(243, 156, 18, 0.15);
    border-radius: 1.25rem;
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    cursor: default;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .cb-card:hover {
    transform: translateY(-8px);
    border-color: #F39C12;
    box-shadow: 0 15px 30px rgba(243, 156, 18, 0.08);
    background: #151515;
  }
  .cb-card__icon-wrap {
    width: 80px;
    height: 80px;
    background: rgba(243, 156, 18, 0.08);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(243, 156, 18, 0.15);
    transition: all 0.4s;
  }
  .cb-card:hover .cb-card__icon-wrap {
    background: rgba(243, 156, 18, 0.16);
    border-color: #F39C12;
  }
</style>
