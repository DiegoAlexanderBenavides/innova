---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Hero background
import heroBg from '../assets/images/desarrolloweb/desarrollo web stock fondo negro.png';

// Galería "Expertos en desarrollo web"
import galImg1 from '../assets/images/services/desarrollo_web_a_medida/desarrollo-enfocado.png';
import galImg2 from '../assets/images/services/desarrollo_web_a_medida/codigo-limpio-esclabel.png';
import galImg3 from '../assets/images/services/desarrollo_web_a_medida/analisis-datos-integrado.png';
import galImg4 from '../assets/images/IMÁGENES/desarrollo web profesional chat gpt.png';

// Iconos features
import iconMonitor  from '../assets/images/RECURSOS/computadora amarillo.png';
import iconSeo      from '../assets/images/ÍCONOS/marca-de-verificacion amarillo.png';
import iconSeguro   from '../assets/images/RECURSOS/verificado amarillo.png';
import iconInteg    from '../assets/images/RECURSOS/conexión amarillo.png';

// Imagenes de números para pasos
import numImg1 from '../assets/images/RECURSOS/1.png';
import numImg2 from '../assets/images/RECURSOS/2.png';
import numImg3 from '../assets/images/RECURSOS/3.png';
import numImg4 from '../assets/images/RECURSOS/4.png';

// Caso de uso
import casoImg from '../assets/images/IMÁGENES/redciclarr.png';
import redciclarMockup from '../assets/images/IMÁGENES/redciclarr.png';
import pcImg from '../assets/images/IMÁGENES/pc.png';

const pageTitle = "Desarrollo Web a Medida | INNOVA SYSTEMS CENTER – Sitios Modernos, Rápidos y Seguros";
const pageDescription = "Creamos sitios web modernos, rápidos y seguros con diseño responsivo, SEO optimizado, integraciones empresariales y tecnología de alto rendimiento.";
const pageKeywords = "desarrollo web a medida, páginas web corporativas, aplicaciones web, desarrollo frontend, desarrollo backend, JavaScript, React, sistemas web personalizados, UX/UI, diseño web moderno, SEO técnico";

const galeria = [
  { img: galImg1.src, label: "Desarrollo enfocado en resultados" },
  { img: galImg2.src, label: "Código limpio y escalable" },
  { img: galImg3.src, label: "Análisis y datos integrados" },
  { img: galImg4.src, label: "Diseño profesional a medida" },
];

const pasos = [
  { num: "01", img: numImg1.src, titulo: "Arquitectura y análisis", desc: "Definimos objetivos, funcionalidades clave y la estructura ideal para tu sitio web desde el inicio." },
  { num: "02", img: numImg2.src, titulo: "Diseño UX/UI", desc: "Creamos una interfaz moderna, intuitiva y adaptada a tu marca y a tus usuarios objetivo." },
  { num: "03", img: numImg3.src, titulo: "Desarrollo funcional", desc: "Construimos el sitio con tecnologías modernas, código escalable y buenas prácticas de ingeniería." },
  { num: "04", img: numImg4.src, titulo: "Optimización y lanzamiento", desc: "SEO técnico, velocidad, seguridad y pruebas exhaustivas antes de publicar al mundo." },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tecnologias = [
  { name: "Python", icono: `${base}/assets/icons/python.png` },
  { name: "JavaScript", icono: `${base}/assets/icons/javascript.png` },
  { name: "HTML", icono: `${base}/assets/icons/html.png` },
  { name: "CSS", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg" },
  { name: "PHP", icono: `${base}/assets/icons/php.png` },
  { name: "React", icono: `${base}/assets/icons/react.png` },
  { name: "Angular", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/angular/angular-original.svg" },
  { name: "Node.js", icono: `${base}/assets/icons/node.png` },
];

const faqs = [
  { q: "¿Cuánto tarda un desarrollo web a medida?",    a: "Dependiendo del alcance, entre 2 y 8 semanas. Proyectos avanzados pueden requerir más tiempo según las funcionalidades requeridas." },
  { q: "¿Incluye SEO técnico?",                         a: "Sí. Todas las webs incluyen optimización técnica: velocidad, etiquetas meta, estructura semántica e indexación correcta." },
  { q: "¿Se integra con mis sistemas actuales?",        a: "Sí. Podemos conectarla con APIs externas, CRMs, ERPs, bases de datos internas o sistemas personalizados." },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main class="dw-main">

    <!-- ══════════════ HERO ══════════════ -->
    <section class="dw-hero" style={`background-image:url('${heroBg.src}')`}>
      <div class="dw-hero__overlay"></div>
      <div class="dw-hero__content">
        <p class="dw-tag">DESARROLLO WEB A MEDIDA</p>
        <h1 class="dw-hero__title">
          Diseño a medida que impulsan<br />
          <span class="text-[#F39C12]">la presencia digital</span>
        </h1>
        <p class="dw-hero__sub">
          Agencia de Diseño y Desarrollo Web y Análisis de Datos
        </p>
        <a href="/contacto#formulario-contacto" class="dw-btn-primary">
          Solicita tu Consultoría Gratuita
        </a>
      </div>
    </section>

    <!-- ══════════════ NUESTRO SERVICIO ══════════════ -->
    <section class="dw-section bg-[#111]">
      <div class="dw-container">
        <p class="dw-tag text-center">SERVICIO DE DESARROLLO WEB A MEDIDA</p>

        <div class="dw-service-grid">
          <!-- Columna izquierda: título + texto -->
          <div class="dw-service-text">
            <h2 class="dw-heading">
              Tu sitio web diseñado para
              <span class="text-[#F39C12]">convertir, posicionar y escalar</span>
            </h2>
            <p class="text-gray-300 text-base leading-relaxed">
              Desarrollamos páginas web modernas, funcionales y completamente a medida,
              creadas para transmitir profesionalismo, cargar rápido, posicionar en Google
              y ofrecer la mejor experiencia a tus usuarios desde cualquier dispositivo.
            </p>
          </div>

          <!-- Columna derecha: 4 feature cards -->
          <div class="dw-features">
            <div class="dw-feature-card">
              <img src={iconMonitor.src} alt="" class="dw-feature-icon" />
              <div>
                <h3 class="dw-feature-title">Diseño profesional y responsivo</h3>
                <p class="dw-feature-desc">Tu sitio se adapta a móviles, tablets y computadores para una experiencia impecable en cualquier pantalla.</p>
              </div>
            </div>
            <div class="dw-feature-card">
              <img src={iconSeo.src} alt="" class="dw-feature-icon" />
              <div>
                <h3 class="dw-feature-title">SEO optimizado desde el inicio</h3>
                <p class="dw-feature-desc">Arquitectura pensada para posicionar en Google: velocidad, estructura, etiquetas y contenido estratégico.</p>
              </div>
            </div>
            <div class="dw-feature-card">
              <img src={iconSeguro.src} alt="" class="dw-feature-icon" />
              <div>
                <h3 class="dw-feature-title">Seguridad robusta</h3>
                <p class="dw-feature-desc">Implementación de HTTPS, certificados SSL, protección contra ataques y buenas prácticas de desarrollo seguro.</p>
              </div>
            </div>
            <div class="dw-feature-card">
              <img src={iconInteg.src} alt="" class="dw-feature-icon" />
              <div>
                <h3 class="dw-feature-title">Integraciones empresariales</h3>
                <p class="dw-feature-desc">Conectamos tu web con bases de datos, CRM, ERPs, plataformas internas o APIs personalizadas.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ GALERÍA — EXPERTOS ══════════════ -->
    <section class="dw-section bg-[#0a0a0a]">
      <div class="dw-container">
        <p class="dw-tag text-center">A NUESTROS CLIENTES</p>
        <h2 class="dw-heading text-center mb-12">
          Expertos en desarrollo web funcional,<br />rápido y orientado al crecimiento
        </h2>

        <div class="dw-gallery">
          {galeria.map(g => (
            <div class="dw-gallery-card">
              <div class="dw-gallery-img-wrap">
                <img src={g.img} alt={g.label} class="dw-gallery-img" />
              </div>
              <div class="dw-gallery-badge-wrap">
                <span class="dw-gallery-badge">{g.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ NUESTRO PROCESO ══════════════ -->
    <section class="dw-section bg-[#111]">
      <div class="dw-container">
        <p class="dw-tag text-center">NUESTRO PROCESO</p>
        <h2 class="dw-heading text-center">
          Un proceso claro para convertir datos<br />en decisiones
        </h2>
        <p class="text-center text-gray-300 max-w-2xl mx-auto mb-12">
          Nuestro flujo de trabajo garantiza un sitio web personalizado, seguro, rápido
          y optimizado para buscadores desde el primer día.
        </p>

        <div class="dw-steps">
          {pasos.map(p => (
            <div class="dw-step-card">
              <!-- Imagen izquierda -->
              <div class="dw-step-img-wrap">
                <img src={p.img} alt={p.titulo} class="dw-step-img" />
              </div>
              <!-- Texto derecha -->
              <div class="dw-step-text">
                <h3 class="dw-step-title">{p.titulo}</h3>
                <p class="dw-step-desc">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ TECNOLOGÍAS ══════════════ -->
    <section class="dw-section bg-[#0a0a0a]">
      <div class="dw-container">
        <div class="dw-tech-grid">
          <!-- Texto izquierda -->
          <div class="dw-tech-text">
            <p class="dw-tag">RECURSOS</p>
            <h2 class="dw-heading">
              Tecnologías modernas<br />y confiables
            </h2>
            <p class="text-gray-300 text-base leading-relaxed">
              Trabajamos con tecnologías seguras, rápidas y escalables para garantizar
              un sitio web moderno, estable y listo para crecer con tu empresa.
              Elegimos la stack más adecuada para cada proyecto y cada cliente.
            </p>
          </div>

          <!-- Grid de tecnologías derecha -->
          <div class="dw-tech-badges">
            {tecnologias.map(t => (
              <div class="dw-tech-badge">
                {t.icono && <img src={t.icono} alt={t.name} class="w-6 h-6 object-contain" />}
                <span>{t.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ CASO DE USO ══════════════ -->
    <section class="dw-section bg-[#111]">
      <div class="dw-container">
        <p class="dw-tag text-center">CASOS DE USO</p>
        <h2 class="dw-heading text-center mb-12">
          Desarrollos web que generan resultados reales
        </h2>
        <p class="text-center text-gray-300 max-w-2xl mx-auto mb-12">
          Estos proyectos muestran cómo un desarrollo web profesional mejora el rendimiento,
          incrementa la conversión y optimiza procesos clave dentro de distintas organizaciones.
        </p>

        <div class="dw-caso">
          <div class="dw-caso-img-wrap">
            <img src={casoImg.src} alt="Redciclar" class="dw-caso-img" />
          </div>
          <div class="dw-caso-body">
            <div class="dw-caso-bar"></div>
            <h3 class="dw-caso-title">
              Crese: Solución Integral de Trazabilidad y Procesos de Residuos
            </h3>
            <p class="dw-caso-client">Redciclar / CRESE</p>
            <p class="dw-caso-desc">
              Plataforma integral para optimizar la trazabilidad y la gestión operativa de residuos,
              con módulos de seguimiento en tiempo real, dashboards analíticos y reportes automatizados.
            </p>
            <a href={`${base}/redciclar-gestion-residuos-cali/`} class="dw-link mt-4 inline-block dw-caso-cta">
              Ver caso completo →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ FAQ ══════════════ -->
    <section class="dw-section bg-[#0a0a0a]">
      <div class="dw-container dw-container--narrow">
        <h2 class="dw-heading text-center mb-4">Preguntas frecuentes</h2>
        <p class="text-center text-gray-400 mb-12">
          Resolvemos las dudas más comunes antes de iniciar tu proyecto de desarrollo web.
        </p>

        <div id="dw-faq-list" class="space-y-4">
          {faqs.map((f, i) => (
            <div class="dw-faq-item" data-faq={i}>
              <button class="dw-faq-btn" type="button">
                <span>{f.q}</span>
                <svg class="dw-faq-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="dw-faq-answer">{f.a}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ CTA FINAL ══════════════ -->
    <section class="dw-cta">
      <div class="dw-container text-center">
        <p class="dw-tag justify-center" style="display:flex;">¿LISTO PARA CREAR UN SITIO WEB PROFESIONAL Y ESCALABLE?</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Agenda una sesión con nuestro equipo y descubre cómo<br />
          <span class="text-[#F39C12]">transformar tu presencia digital</span>
        </h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-10">
          Hay un mundo de posibilidades esperándote. Cuéntanos tu proyecto: tienes una idea
          que impulsar y estás listo para crecer, este es el primer paso.
        </p>
        <a href="/contacto#formulario-contacto" class="dw-btn-primary dw-btn-primary--lg">
          Agenda una Sesión
        </a>
      </div>
    </section>

  </main>

  <!-- ══════════ MODAL REDCICLAR ══════════ -->
  <div id="modal-redciclar" class="rc-modal" role="dialog" aria-modal="true" aria-labelledby="rc-modal-title" hidden>
    <div class="rc-modal__backdrop"></div>
    <div class="rc-modal__sheet">

      <!-- CERRAR -->
      <button id="btn-cerrar-redciclar" class="rc-modal__close" aria-label="Cerrar">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <!-- ── HERO ── -->
      <section class="rc-hero">
        <div class="rc-hero__left">
          <span class="rc-tag">PLATAFORMA REDCICLAR</span>
          <h2 id="rc-modal-title" class="rc-hero__title">
            Digitalizamos tu<br />
            <span class="rc-accent">impacto ambiental</span>
          </h2>
          <p class="rc-hero__sub">
            Solución web que centraliza información, optimiza rutas y visualiza resultados ambientales en tiempo real.
          </p>
          <div class="rc-hero__features">
            <div class="rc-feat">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
              <span>Datos<br/>centralizados</span>
            </div>
            <div class="rc-feat">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
              <span>Rutas<br/>optimizadas</span>
            </div>
            <div class="rc-feat">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              <span>Analítica<br/>en tiempo real</span>
            </div>
            <div class="rc-feat">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              <span>Reportes<br/>automáticos</span>
            </div>
          </div>
        </div>
        <div class="rc-hero__right">
          <img src={redciclarMockup.src} alt="Dashboard Redciclar" class="rc-hero__mockup" />
        </div>
      </section>

      <!-- ── BENEFICIOS ── -->
      <section class="rc-section rc-section--gray">
        <p class="rc-tag rc-tag--center">BENEFICIOS QUE GENERA REDCICLAR</p>
        <div class="rc-benefits">
          <div class="rc-benefit-card">
            <div class="rc-benefit-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <h3 class="rc-benefit-title">Decisiones basadas en datos reales</h3>
            <p class="rc-benefit-desc">Información confiable y actualizada para planificar acciones efectivas.</p>
          </div>
          <div class="rc-benefit-card">
            <div class="rc-benefit-icon rc-benefit-icon--green">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <h3 class="rc-benefit-title">Menos costos, más eficiencia</h3>
            <p class="rc-benefit-desc">Rutas inteligentes que reducen tiempos, distancias y gastos.</p>
          </div>
          <div class="rc-benefit-card">
            <div class="rc-benefit-icon rc-benefit-icon--blue">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="rc-benefit-title">Transparencia que genera confianza</h3>
            <p class="rc-benefit-desc">Reportes listos para auditorías y rendición de cuentas.</p>
          </div>
        </div>
      </section>

      <!-- ── INTEGRACIÓN ── -->
      <section class="rc-section rc-integ">
        <div class="rc-integ__left">
          <h3 class="rc-integ__title">
            Conecta tus operaciones con <span class="rc-accent">resultados medibles</span>
          </h3>
          <p class="rc-integ__sub">
            Te ayudamos a integrar lo que sucede en campo con tecnología que transforma.
          </p>
          <a href="/contacto#formulario-contacto" class="rc-btn" onclick="document.getElementById('modal-redciclar').setAttribute('hidden','');document.body.style.overflow=''">
            Agendar Diagnóstico Gratis
          </a>
        </div>
        <div class="rc-integ__right">
          <img src={pcImg.src} alt="Integración Redciclar" class="rc-integ__img" />
        </div>
      </section>

      <!-- ── PROCESO ── -->
      <section class="rc-section rc-section--gray">
        <p class="rc-tag rc-tag--center">ASÍ TRABAJAMOS</p>
        <div class="rc-proceso">
          <div class="rc-paso">
            <div class="rc-paso__circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            </div>
            <h4 class="rc-paso__title">1. Capturamos</h4>
            <p class="rc-paso__desc">Recolectamos datos de campo desde múltiples fuentes.</p>
          </div>
          <div class="rc-paso__arrow">›</div>
          <div class="rc-paso">
            <div class="rc-paso__circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M16.24 7.76a6 6 0 0 1 0 8.49M4.93 4.93a10 10 0 0 0 0 14.14M7.76 7.76a6 6 0 0 0 0 8.49"/></svg>
            </div>
            <h4 class="rc-paso__title">2. Procesamos</h4>
            <p class="rc-paso__desc">Organizamos y validamos la información automáticamente.</p>
          </div>
          <div class="rc-paso__arrow">›</div>
          <div class="rc-paso">
            <div class="rc-paso__circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8l-4 4 4 4M16 12H8"/></svg>
            </div>
            <h4 class="rc-paso__title">3. Optimizamos</h4>
            <p class="rc-paso__desc">Generamos rutas eficientes con algoritmos inteligentes.</p>
          </div>
          <div class="rc-paso__arrow">›</div>
          <div class="rc-paso">
            <div class="rc-paso__circle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <h4 class="rc-paso__title">4. Visualizamos</h4>
            <p class="rc-paso__desc">Dashboards claros para medir y actuar en tiempo real.</p>
          </div>
        </div>
      </section>

    </div>
  </div>

  <Footer />
</Layout>

<style is:global>
