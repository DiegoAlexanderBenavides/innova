---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Imágenes hero + fondo
import heroBg        from '../assets/images/ÍCONOS IMÁGENES SERVICIOS ANÁLISIS DE DATOS/análisis de datos para empresas gpt fondo negro.png';

// Íconos feature
import iconAnalisis  from '../assets/images/ÍCONOS IMÁGENES SERVICIOS ANÁLISIS DE DATOS/analisis de datos blanco.png';
import iconTuercas   from '../assets/images/ÍCONOS IMÁGENES SERVICIOS ANÁLISIS DE DATOS/tuercas amarillo.png';
import iconVerificado from '../assets/images/ÍCONOS IMÁGENES SERVICIOS ANÁLISIS DE DATOS/verificado amarillo.png';

// Galería "Expertos"
import galImg1 from '../assets/images/RECURSOS/equipo-recoleccion-analisis-datos.png';
import galImg2 from '../assets/images/RECURSOS/procesos-recoleccion-claros-personalizables.png';
import galImg3 from '../assets/images/RECURSOS/analisis-estrategico-revela-oportunidades.png';
import galImg4 from '../assets/images/RECURSOS/analisis-datos-integrado.png';

// Imágenes de números para pasos
import numImg1 from '../assets/images/RECURSOS/1.png';
import numImg2 from '../assets/images/RECURSOS/2.png';
import numImg3 from '../assets/images/RECURSOS/3.png';
import numImg4 from '../assets/images/RECURSOS/4.png';

// Caso de uso
import casoImg from '../assets/images/ÍCONOS IMÁGENES SERVICIOS ANÁLISIS DE DATOS/makikuna.png';
import casoImg2 from '../assets/images/ven_y_juega.png';

const pageTitle = "Recolección y Análisis de Datos | INNOVA SYSTEMS CENTER";
const pageDescription = "Servicio especializado en recolección y análisis de datos. Dashboards, automatización y datos confiables para empresas modernas.";
const pageKeywords = "recolección de datos, análisis de datos, dashboards, Power BI, business intelligence, transformación digital";

const galeria = [
  { img: galImg1.src, label: "Equipos multidisciplinares dedicados al análisis" },
  { img: galImg2.src, label: "Procesos de recolección claros y personalizables" },
  { img: galImg3.src, label: "Plataformas de análisis y visualización estratégica" },
  { img: galImg4.src, label: "Análisis de datos que generan valor empresarial" },
];

const pasos = [
  { num: "01", img: numImg1.src, titulo: "Recolección de datos",    desc: "Procesos claros y adaptados a tus sistemas para capturar información confiable desde el origen." },
  { num: "02", img: numImg2.src, titulo: "Limpieza y organización", desc: "Depuramos, validamos y estructuramos tus datos para convertirlos en información útil y confiable." },
  { num: "03", img: numImg3.src, titulo: "Análisis profundo",        desc: "Detectamos patrones, oportunidades, fallos y comportamientos clave en tu operación." },
  { num: "04", img: numImg4.src, titulo: "Entrega estratégica",      desc: "Recibes reportes visuales, insights accionables y recomendaciones claras para mejorar decisiones." },
];

const faqs = [
  { q: "¿Qué tipo de datos pueden analizar?",           a: "Podemos trabajar con datos operativos, administrativos, comerciales, educativos, financieros y más, desde múltiples fuentes digitales." },
  { q: "¿Pueden organizar datos incompletos o desordenados?", a: "Sí. Reconstruimos, depuramos y organizamos datos incluso cuando vienen incompletos, duplicados o sin estructura." },
  { q: "¿Se integran con mis sistemas actuales?",       a: "Sí. Podemos conectar tus datos con CRM, ERP, bases SQL, hojas de cálculo, APIs y otros sistemas internos." },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />

  <main class="min-h-screen flex flex-col bg-[#0a0a0a] text-white">

    <!-- ══════════════ HERO ══════════════ -->
    <section class="ad-hero" style={`background-image:url('${heroBg.src}')`}>
      <div class="ad-hero__overlay"></div>
      <div class="ad-hero__content">
        <p class="ad-tag">ANÁLISIS DE DATOS</p>
        <h1 class="ad-hero__title">
          Datos que Impulsan<br />
          <span class="text-[#F39C12]">Decisiones Inteligentes</span>
        </h1>
        <p class="ad-hero__sub">
          Agencia Especializada en Recolección y Análisis de Datos
        </p>
        <a href="/contacto#formulario-contacto" class="ad-btn-primary">
          Solicita tu Consultoría Gratuita
        </a>
      </div>
    </section>

    <!-- ══════════════ NUESTRO SERVICIO ══════════════ -->
    <section class="ad-section bg-[#111]">
      <div class="ad-container">
        <p class="ad-tag text-center">NUESTRO SERVICIO</p>

        <div class="ad-service-grid">
          <!-- Columna izquierda: título + texto -->
          <div class="ad-service-text">
            <h2 class="ad-heading">
              Recolección y análisis de datos que
              <span class="text-[#F39C12]">impulsan tu crecimiento</span>
            </h2>
            <p class="text-gray-300 text-base leading-relaxed">
              Diseñamos procesos precisos para capturar, organizar y transformar
              tus datos en dashboards y reportes útiles que fortalecen tu
              estrategia digital y mejoran el rendimiento de tu organización.
            </p>
          </div>

          <!-- Columna derecha: 3 feature cards -->
          <div class="ad-features">
            <div class="ad-feature-card">
              <img src={iconAnalisis.src} alt="" class="ad-feature-icon" />
              <div>
                <h3 class="ad-feature-title">Visualización en tiempo real</h3>
                <p class="ad-feature-desc">Dashboards personalizados que muestran tus métricas clave con claridad y datos actualizados en todo momento.</p>
              </div>
            </div>
            <div class="ad-feature-card">
              <img src={iconTuercas.src} alt="" class="ad-feature-icon" />
              <div>
                <h3 class="ad-feature-title">Automatización de procesos</h3>
                <p class="ad-feature-desc">Flujos automatizados que eliminan tareas repetitivas y aceleran el análisis operativo sin errores de captura.</p>
              </div>
            </div>
            <div class="ad-feature-card">
              <img src={iconVerificado.src} alt="" class="ad-feature-icon" />
              <div>
                <h3 class="ad-feature-title">Datos confiables y seguros</h3>
                <p class="ad-feature-desc">Sistemas robustos con validación de datos, integraciones seguras y estructuras diseñadas para crecer contigo.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ GALERÍA — EXPERTOS ══════════════ -->
    <section class="ad-section bg-[#0a0a0a]">
      <div class="ad-container">
        <p class="ad-tag text-center">A NUESTROS CLIENTES</p>
        <h2 class="ad-heading text-center mb-12">
          Expertos en transformar datos en<br />decisiones estratégicas
        </h2>

        <div class="ad-gallery">
          {galeria.map(g => (
            <div class="ad-gallery-card">
              <div class="ad-gallery-img-wrap">
                <img src={g.img} alt={g.label} class="ad-gallery-img" />
              </div>
              <div class="ad-gallery-badge-wrap">
                <span class="ad-gallery-badge">{g.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ NUESTRO PROCESO ══════════════ -->
    <section class="ad-section bg-[#111]">
      <div class="ad-container">
        <p class="ad-tag text-center">NUESTRO PROCESO</p>
        <h2 class="ad-heading text-center">
          Un proceso claro para convertir datos en decisiones
        </h2>
        <p class="text-center text-gray-300 max-w-2xl mx-auto mb-12">
          Nuestro flujo de trabajo permite pasar desde la recolección hasta el
          análisis final sin confusiones y con resultados totalmente medibles.
        </p>

        <div class="ad-steps">
          {pasos.map(p => (
            <div class="ad-step-card">
              <!-- Imagen izquierda -->
              <div class="ad-step-img-wrap">
                <img src={p.img} alt={p.titulo} class="ad-step-img" />
              </div>
              <!-- Texto derecha -->
              <div class="ad-step-text">
                <h3 class="ad-step-title">{p.titulo}</h3>
                <p class="ad-step-desc">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ CASO DE USO ══════════════ -->
    <section class="ad-section bg-[#0a0a0a]">
      <div class="ad-container">
        <p class="ad-tag text-center">CASOS DE USO</p>
        <h2 class="ad-heading text-center mb-12">
          Resultados reales con datos reales
        </h2>

        <div class="ad-casos-grid">
          <!-- Tarjeta 1: Makikuna Analítica -->
          <div class="ad-caso-card">
            <div class="ad-caso-card-img-wrap">
              <img src={casoImg.src} alt="Fundación Makikuna" class="ad-caso-card-img" />
            </div>
            <div class="ad-caso-card-body">
              <div class="ad-caso-card-bar"></div>
              <h3 class="ad-caso-card-title">
                Automatización para la Recolección y Analítica de Datos
              </h3>
              <p class="text-[#F39C12] font-semibold mb-2 text-sm">Fundación Makikuna</p>
              <p class="ad-caso-card-desc mb-4">
                Desarrollo de sistemas de datos (registro, análisis y visualización) para la
                recolección eficiente y el entendimiento profundo de la información estratégica
                de la fundación.
              </p>
              <div class="mt-auto">
                <a href="/fundacion-makikuna-gestion-de-datos" class="ad-link inline-block">
                  Ver caso completo →
                </a>
              </div>
            </div>
          </div>

          <!-- Tarjeta 2: Ven y Juega -->
          <div class="ad-caso-card">
            <div class="ad-caso-card-img-wrap">
              <img src={casoImg2.src} alt="Programa Ven y Juega" class="ad-caso-card-img" />
            </div>
            <div class="ad-caso-card-body">
              <div class="ad-caso-card-bar"></div>
              <h3 class="ad-caso-card-title">
                Estructuración y Limpieza de Bases de Datos
              </h3>
              <p class="text-[#F39C12] font-semibold mb-2 text-sm">Fundación Makikuna (Programa Ven y Juega)</p>
              <p class="ad-caso-card-desc mb-4">
                La Fundación Makikuna enfrentaba una base de datos desorganizada y con registros duplicados en su programa “Ven y Juega”, dificultando la generación de reportes confiables y la evaluación del impacto del proyecto.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ FAQ ══════════════ -->
    <section class="ad-section bg-[#111]">
      <div class="ad-container max-w-3xl">
        <h2 class="ad-heading text-center mb-4">Preguntas frecuentes</h2>
        <p class="text-center text-gray-400 mb-12">
          Resolvemos las dudas más comunes antes de iniciar tu proceso con nosotros.
        </p>

        <div id="faq-list" class="space-y-4">
          {faqs.map((f, i) => (
            <div class="ad-faq-item" data-faq={i}>
              <button class="ad-faq-btn" type="button">
                <span>{f.q}</span>
                <svg class="ad-faq-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="ad-faq-answer">{f.a}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════ CTA FINAL ══════════════ -->
    <section class="ad-cta">
      <div class="ad-container text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          ¿Listo para transformar tus datos en ventaja competitiva?
        </h2>
        <p class="text-gray-300 max-w-2xl mx-auto mb-10">
          Hablemos sobre cómo llevar tus procesos a otro nivel con recolección,
          organización y análisis de datos diseñados para escalar tu negocio.
        </p>
        <a href="/contacto#formulario-contacto" class="ad-btn-primary text-lg px-12 py-4">
          Agéndame Sesión
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  /* ── Variables / utilidades ── */
  .ad-container  { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; width: 100%; }
  .ad-section    { padding: 5rem 1.5rem; }
  .ad-tag        { color: #F39C12; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 0.75rem; display: block; }
  .ad-heading    { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; color: #fff; line-height: 1.2; margin-bottom: 1.25rem; }
  .ad-link       { color: #F39C12; font-weight: 600; text-decoration: none; }
  .ad-link:hover { text-decoration: underline; }

  /* ── Botón primario ── */
  .ad-btn-primary {
    display: inline-block;
    background: #F39C12; color: #000;
    font-weight: 700; font-size: 0.95rem;
    padding: 0.85rem 2rem; border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.25s, transform 0.2s;
  }
  .ad-btn-primary:hover { background: #ffc04a; transform: scale(1.04); }

  /* ── Hero ── */
  .ad-hero {
    position: relative;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex; align-items: center;
  }
  .ad-hero__overlay {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }
  .ad-hero__content {
    position: relative; z-index: 2;
    max-width: 1200px; margin: 0 auto; padding: 8rem 1.5rem 4rem;
    text-align: left;
  }
  .ad-hero__title { font-size: clamp(2rem, 5vw, 3.8rem); font-weight: 900; line-height: 1.15; margin-bottom: 1rem; color: #fff; }
  .ad-hero__sub   { color: #ddd; font-size: 1.15rem; margin-bottom: 2rem; max-width: 460px; }

  /* ── Servicio grid ── */
  .ad-service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
    margin-top: 1.5rem;
  }
  @media (max-width: 860px) { .ad-service-grid { grid-template-columns: 1fr; gap: 2rem; } }

  /* ── Feature cards (columna derecha del servicio) ── */
  .ad-features { display: flex; flex-direction: column; gap: 1.2rem; }
  .ad-feature-card {
    display: flex; align-items: flex-start; gap: 1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(243,156,18,0.18);
    border-radius: 0.9rem; padding: 1.1rem 1.2rem;
    transition: border-color 0.3s, background 0.3s;
  }
  .ad-feature-card:hover { border-color: rgba(243,156,18,0.5); background: rgba(243,156,18,0.06); }
  .ad-feature-icon  { width: 40px; height: 40px; object-fit: contain; flex-shrink: 0; margin-top: 2px; }
  .ad-feature-title { color: #fff; font-weight: 700; font-size: 0.95rem; margin-bottom: 0.3rem; }
  .ad-feature-desc  { color: #9ca3af; font-size: 0.82rem; line-height: 1.5; }

  /* ── Galería 4 imágenes ── */
  .ad-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 900px) { .ad-gallery { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .ad-gallery { grid-template-columns: 1fr; } }

  .ad-gallery-card {
    border-radius: 0.85rem; overflow: hidden;
    background: #1a1a1a;
    border: 1px solid rgba(243,156,18,0.15);
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex; flex-direction: column;
  }
  .ad-gallery-card:hover { transform: translateY(-5px); box-shadow: 0 8px 32px rgba(243,156,18,0.2); }
  .ad-gallery-img-wrap { overflow: hidden; }
  .ad-gallery-img   { width: 100%; height: 160px; object-fit: cover; display: block; transition: transform 0.4s; }
  .ad-gallery-card:hover .ad-gallery-img { transform: scale(1.06); }
  /* Badge amarillo redondeado */
  .ad-gallery-badge-wrap { padding: 0.7rem 0.8rem; }
  .ad-gallery-badge {
    display: inline-block;
    background: #F39C12;
    color: #fff;
    font-size: 0.75rem; font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    line-height: 1.4;
    text-align: center;
  }

  /* ── Pasos del proceso (2×2 grid) ── */
  .ad-steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  @media (max-width: 640px) { .ad-steps { grid-template-columns: 1fr; } }

  /* Tarjeta: layout horizontal imagen izquierda + texto derecha */
  .ad-step-card {
    background: #1a1a1a;
    border: 1px solid rgba(243,156,18,0.15);
    border-radius: 1rem; overflow: hidden;
    display: flex; flex-direction: row; align-items: stretch;
    transition: border-color 0.3s, transform 0.3s;
  }
  .ad-step-card:hover { border-color: #F39C12; transform: translateY(-4px); }

  /* Imagen izquierda con número encima */
  .ad-step-img-wrap {
    position: relative;
    width: 130px; flex-shrink: 0;
    overflow: hidden;
  }
  .ad-step-img {
    width: 100%; height: 100%; object-fit: cover;
    display: block; transition: transform 0.4s;
  }
  .ad-step-card:hover .ad-step-img { transform: scale(1.07); }

  /* Texto derecha */
  .ad-step-text  { padding: 1.25rem 1.1rem; flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .ad-step-title { color: #fff; font-size: 0.98rem; font-weight: 700; margin-bottom: 0.5rem; }
  .ad-step-desc  { color: #9ca3af; font-size: 0.82rem; line-height: 1.5; }

  /* ── Caso de uso ── */
  .ad-casos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (max-width: 860px) {
    .ad-casos-grid {
      grid-template-columns: 1fr;
    }
  }

  .ad-caso-card {
    background: #1a1a1a;
    border: 1px solid rgba(243,156,18,0.25);
    border-radius: 1.1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s, border-color 0.3s;
    height: 100%;
  }
  .ad-caso-card:hover {
    transform: translateY(-5px);
    border-color: #F39C12;
  }
  .ad-caso-card-img-wrap {
    overflow: hidden;
    height: 240px;
    width: 100%;
  }
  .ad-caso-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .ad-caso-card:hover .ad-caso-card-img {
    transform: scale(1.05);
  }
  .ad-caso-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .ad-caso-card-bar {
    width: 60px;
    height: 3px;
    background: #F39C12;
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }
  .ad-caso-card-title {
    color: #fff;
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }
  .ad-caso-card-desc {
    color: #9ca3af;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  /* ── FAQ ── */
  .ad-faq-item {
    background: #1a1a1a;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.8rem; overflow: hidden;
    transition: border-color 0.3s;
  }
  .ad-faq-item.open { border-color: rgba(243,156,18,0.4); }
  .ad-faq-btn {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    padding: 1.1rem 1.25rem; background: none; border: none; cursor: pointer;
    color: #fff; font-size: 0.97rem; font-weight: 600; text-align: left; gap: 1rem;
  }
  .ad-faq-arrow {
    width: 20px; height: 20px; color: #F39C12; flex-shrink: 0;
    transition: transform 0.3s;
  }
  .ad-faq-item.open .ad-faq-arrow { transform: rotate(180deg); }
  .ad-faq-answer {
    max-height: 0; overflow: hidden;
    color: #9ca3af; font-size: 0.88rem; line-height: 1.6;
    transition: max-height 0.35s ease, padding 0.3s;
    padding: 0 1.25rem;
  }
  .ad-faq-item.open .ad-faq-answer { max-height: 200px; padding: 0 1.25rem 1.1rem; }

  /* ── CTA Final ── */
  .ad-cta {
    padding: 5rem 1.5rem;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a0d00 50%, #0a0a0a 100%);
    text-align: center;
  }
</style>

<script>
  document.querySelectorAll('.ad-faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.ad-faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.ad-faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });
</script>
